<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX manifest, for the Store and the download feed.

  Written by hand rather than generated by a packaging project, because the app is one SDK-style
  csproj and adding a .wapproj would mean a second project, a second build, and a second place for
  the version number to be wrong. `scripts/package.ps1` fills in the placeholders and calls
  makeappx over a published folder — the Desktop Bridge shape, which is exactly what a Win32 app
  with no packaged-only APIs needs.

  ProcessorArchitecture and Version are substituted by the script. Everything else is the truth
  about the app.

  Two things this buys that the unpackaged build does without:
    - `astrid://` is declared here rather than written into HKCU at startup, so it is registered by
      the installer and removed by the uninstaller.
    - Notifications come from a packaged identity, which is what Windows expects; the unpackaged
      build registers its own AUMID at runtime (see docs/M0_NOTES.md).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    ASSIGNED BY PARTNER CENTER, not chosen here.

    Reserving the app name produces an Identity Name and a Publisher, and the Publisher is a
    machine-generated string — `CN=` followed by a GUID — rather than the company name. A package
    whose Identity does not match the reservation byte for byte is rejected at upload, so these are
    substituted by scripts/package.ps1 from the values in packaging/store-identity.json rather than
    guessed at.

    The name people actually read is PublisherDisplayName below, which is the same string the App
    Store shows: Graceful Tools LLC.
  -->
  <Identity
    Name="{IDENTITY_NAME}"
    Publisher="{IDENTITY_PUBLISHER}"
    Version="{VERSION}"
    ProcessorArchitecture="{ARCHITECTURE}" />

  <Properties>
    <DisplayName>Astrid</DisplayName>
    <PublisherDisplayName>Graceful Tools LLC</PublisherDisplayName>
    <Description>Tasks, shared with the people you share them with.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 is what the app targets; earlier builds have no Windows App SDK. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="de-DE" />
  </Resources>

  <Applications>
    <Application Id="Astrid" Executable="Astrid.App.exe" EntryPoint="Windows.FullTrustApplication">
      <!--
        Every tile Windows asks for. It shipped with three, so Start and the Store fell back to
        scaling a 44px placeholder into a 310px slot.

        The scale- and targetsize- variants beside these on disk are picked up by name; only the
        base asset is named here, which is how MSIX resource resolution works. The unplated ones
        matter most: they are what the taskbar draws, where the tile background must not show.

        BackgroundColor stays transparent so the artwork sits on the user's accent rather than on a
        colour of ours that would fight it.
      -->
      <uap:VisualElements
        DisplayName="Astrid"
        Description="Tasks, shared with the people you share them with."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="Astrid"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>
      <Extensions>
        <!--
          The sign-in hand-off comes back through this. Declared here so the installer registers it
          and the uninstaller takes it away — the unpackaged build writes the same thing into HKCU
          at startup and leaves it behind.
        -->
        <uap:Extension Category="windows.protocol">
          <!--
            The display name is an element rather than an attribute: the uap schema puts it inside
            Protocol, and makeappx rejects the attribute form outright.
          -->
          <uap:Protocol Name="astrid">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:DisplayName>Astrid</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The network, and nothing else. No files beyond what a picker hands over, no devices. -->
    <Capability Name="internetClient" />
    <!--
      Required by `EntryPoint="Windows.FullTrustApplication"`: a Win32 program in a package is a
      full-trust program, and the manifest has to say so. It is the Desktop Bridge shape rather
      than an extra permission — the app can already do everything a desktop app can do.
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
