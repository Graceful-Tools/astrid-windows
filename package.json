{
  "name": "astrid-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Astrid for Windows - native Rust core with a WinUI 3 shell.",
  "license": "MIT",
  "scripts": {
    "predeploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/predeploy.ps1",
    "predeploy:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/predeploy.ps1 -Quick",
    "predeploy:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/predeploy.ps1 -Full",
    "contracts": "node contracts/export-from-web.mjs",
    "contracts:check": "node contracts/export-from-web.mjs --check"
  }
}
