<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Astrid.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Astrid.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    The shared checkbox art, vendored at `design/AstridCheckbox.xaml` and generated
                    by astrid-core from the same source the web and the Apple clients draw (DS21).

                    It is `currentColor` art: the box and the repeat frame stroke from
                    `{TemplateBinding Foreground}`, so whoever draws one decides its colour, which is
                    how a priority token reaches the mark on every row. It replaced sixteen PNGs that
                    baked priority, repeating and done into one picture — and baked four colours in
                    with them (task 82e4ad32).
                -->
                <ResourceDictionary Source="ms-appx:///Assets/Design/AstridCheckbox.xaml" />
                <!--
                    The shared colours, vendored at `design/AstridTokens.xaml` and generated by
                    astrid-core from the same `design/tokens.json` every other client reads.

                    Sixty-six brushes were written out by hand here until task 1fae8c54, in three
                    theme dictionaries, with `DesignTokenTests` comparing each one to this file. A
                    check is not the same as a source: a re-vendor turned every changed token into a
                    red test and a hand-edit, which is the step a colour drifts in. Now the shell
                    paints with astrid-core's own output and there is nothing left to transcribe.

                    Ocean is deliberately absent: in the tokens it differs from light only in the
                    page background (cyan) and its border, and this shell paints that as a surface
                    behind the chrome. One set of brushes, two appearances.

                    `ThemeBrushes` reads these from code, and it has to look *through* this merge to
                    find them — see that file. The accent ramp below is not here because the register
                    holds none of its shades (`design/README.md`).
                -->
                <ResourceDictionary Source="ms-appx:///Assets/Design/AstridTokens.xaml" />
                <!-- The shell's own converters, styles and shared templates; see that file. -->
                <views:ShellResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The accent is the BRAND's, not the machine's.

                WinUI derives every accent brush from SystemAccentColor, which follows whatever
                colour the person has chosen in Windows personalisation. That makes a well-behaved
                Windows app and a badly-behaved Astrid one: the accent carries priority, selection
                and the primary action, and on a machine set to orange none of those read as this
                product. The Apple clients take the accent from Brand for the same reason — "Theme
                abstracts light vs dark; it must also abstract *whose* blue".

                Overriding the colour rather than the brushes is what makes it reach all of them:
                the light and dark variants below are the shades WinUI expects to derive from.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#2563EB</Color>
                    <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>

                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#2563EB</Color>
                    <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>

                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#2563EB</Color>
                    <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
                    <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
                    <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>
                    <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
                    <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
                    <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Astrid's blue: the brand accent from the shared tokens, `design/tokens.resolved.json`
                at `design/REVISION`. Stated once so a control that needs the brand colour does not
                spell the hex again and drift from it - and `DesignTokenTests` compares it to the
                vendored copy, because a comment pointing at a source is not a check against it.

                Darkened from #3B82F6 on 2026-11-11 (DS26, Jon: "Darken accent and error in the
                shared tokens, every platform follows"), so that a white label on it reads: 5.17:1,
                where the old blue was 3.68:1. This is the FILL. Text and icons take
                `AstridAccentInk`, which follows the theme.

                No longer the default list colour, which is a person's choice from a palette and
                stays the blue it was - astrid-core's register names the list palette among the
                values DS26 leaves alone.
            -->
            <SolidColorBrush x:Key="AstridAccentBrush" Color="#2563EB" />

            <!--
                The same accent as a Color, which a tint needs: a SolidColorBrush takes an opacity
                off a colour, not off another brush.
            -->
            <Color x:Key="AstridAccentColor">#2563EB</Color>

            <!--
                A selected row's outline (astrid-core DS5, task 787c7aa5): the accent at
                `state.selection-outline-opacity`. The Mac's answer, which Jon took for every client
                on 2026-11-10 - the sidebar used to FILL the row instead, at 0.15, with its hover and
                pressed states at 0.22, three numbers carried over from astrid-web's CSS and pinned
                to nothing.

                Stated here beside the accent rather than in the theme dictionaries, for the same
                reason `AstridAccentBrush` is: the accent does not follow the theme (DS26), so the
                outline drawn from it does not either. The width that goes with it is a density
                lookup and lives with the other sizes, in `Views/ShellResources.xaml`.
            -->
            <SolidColorBrush x:Key="AstridSelectionOutline"
                             Color="{StaticResource AstridAccentColor}"
                             Opacity="0.55" />

            <!--
                The Done pill's wash and stroke (astrid-core DS33, task ec8cab8a): Done's meaning,
                which `pill.states` maps to the accent, at `pill.fill-opacity` and
                `pill.stroke-opacity`. Stated here for the selection outline's reason - the accent
                does not follow the theme, so neither does a tint of it. The label is
                `AstridAccentInk`, which does. `BoardBadgeStyleTests` holds both opacities to the
                vendored tokens.
            -->
            <SolidColorBrush x:Key="AstridDonePillFill"
                             Color="{StaticResource AstridAccentColor}"
                             Opacity="0.15" />
            <SolidColorBrush x:Key="AstridDonePillStroke"
                             Color="{StaticResource AstridAccentColor}"
                             Opacity="0.4" />

            <!--
                A trade-off grid's five ratings, worst to best (task cca2483d).

                Outside the theme dictionaries on purpose, like the accent above and for a stronger
                version of the same reason. These are not Astrid's palette at all — they are the
                Google Docs ratings palette, `palette/tradeoff` in the vendored design tokens, and
                web draws exactly these five in both themes with no dark variant. A grid is read by
                comparing one cell against another, so the comparison has to survive a reader on a
                dark machine talking to a reader on a light one about the same decision.

                Each fill carries its own ink (`palette/tradeoff-text`): the two dark fills take
                white and the three light ones near-black, which is the contrast decision already
                made for these exact colours rather than one taken again here.

                `The_tradeoff_palette_matches_the_tokens_task_cca2483d` in DesignTokenTests reads
                both arrays out of design/tokens.resolved.json and fails if either drifts.
            -->
            <SolidColorBrush x:Key="AstridTradeoffVeryPoor" Color="#CC0000" />
            <SolidColorBrush x:Key="AstridTradeoffVeryPoorInk" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AstridTradeoffPoor" Color="#E06666" />
            <SolidColorBrush x:Key="AstridTradeoffPoorInk" Color="#111827" />
            <SolidColorBrush x:Key="AstridTradeoffMixed" Color="#FFD966" />
            <SolidColorBrush x:Key="AstridTradeoffMixedInk" Color="#111827" />
            <SolidColorBrush x:Key="AstridTradeoffGood" Color="#93C47D" />
            <SolidColorBrush x:Key="AstridTradeoffGoodInk" Color="#111827" />
            <SolidColorBrush x:Key="AstridTradeoffVeryGood" Color="#38761D" />
            <SolidColorBrush x:Key="AstridTradeoffVeryGoodInk" Color="#FFFFFF" />

            <!--
                A list with no readable colour: `palette/list`'s blue, the colour a new list is
                given. Not the accent - DS26 darkened that and left the list palette alone. Stated
                once here for the three converters that fall back to it (task c4174b14), and
                `The_list_fallback_is_the_list_palettes_blue_task_c4174b14` checks it is in the
                palette.
            -->
            <Color x:Key="AstridListDefaultColor">#3B82F6</Color>

            <!-- The Ocean surface, so the wash is stated once rather than per screen. -->
            <LinearGradientBrush x:Key="AstridOceanBrush" StartPoint="0,0" EndPoint="0.35,1">
                <GradientStop Color="#88DCF8" Offset="0" />
                <GradientStop Color="#C7EEFB" Offset="0.55" />
                <GradientStop Color="#F9FAFB" Offset="1" />
            </LinearGradientBrush>

        </ResourceDictionary>
    </Application.Resources>
</Application>
