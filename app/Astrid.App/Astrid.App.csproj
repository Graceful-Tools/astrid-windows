<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinUI 3 shell. Windows, XAML, key dispatch, platform adapters — and nothing else.

    Everything it draws is decided in astrid-core and arrives as a command response. If a file in
    this project ever needs to know what a row shows, which tasks belong in a list, or what
    completing one means, the answer belongs in the core and this project should be asking for it.
  -->
  <!--
    The words. One file per language under Strings/<tag>/; a translator adds a folder beside en-US
    and nothing else changes — the SDK picks up every .resw in the project on its own. Strings.cs
    holds the same English as a fallback for the build whose .pri does not make it next to the
    executable.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Astrid.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The taskbar, Alt-Tab and Explorer read this, and only this — the MSIX tiles do not reach the
      UNPACKAGED build, which is the one a developer runs and the one the smoke tests drive. It had
      no icon at all and wore the generic .NET one. Generated from the shared master by
      scripts/make-icons.ps1 (task 70ffe6c3).
    -->
    <ApplicationIcon>Assets\Astrid.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!--
      Unpackaged by default, packaged on request.

      The unpackaged build is what a developer runs with F5 and what the UI smoke tests drive, so
      it stays the default. `-p:AstridPackaged=true` leaves WindowsPackageType unset, which is the
      SDK's way of saying MSIX — that is the Store build, and the only one whose `astrid://` comes
      from the manifest rather than from the app writing its own registry key at startup.

      One property rather than a second project: a .wapproj would mean a second build and a second
      place for the version number to be wrong, which is the reason the manifest is hand-written
      too (see packaging/README.md).
    -->
    <WindowsPackageType Condition="'$(AstridPackaged)' != 'true'">None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      LibraryImport generates unsafe marshalling code, the same as the bindings project. The app's
      own code has no unsafe blocks in it.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The entry point is hand-written (Program.cs) so the app can be single-instance and receive
      the sign-in callback as a redirected activation. The generated one starts a second copy per
      launch, which for this app means a second copy with none of the flow state the first is
      waiting with.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!--
    The checkbox marks, copied from astrid-web's public/icons.

    The same PNGs the web draws, so a priority reads identically on both. Drawing an equivalent in
    XAML was the alternative and it is the wrong one: the mark carries priority, repetition and
    completion in one image, and a hand-drawn copy would drift from the web the first time either
    changed.
  -->
  <ItemGroup>
    <Content Include="Assets\Checkboxes\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astrid.Core.Bindings\Astrid.Core.Bindings.csproj" />
    <ProjectReference Include="..\Astrid.App.ViewModels\Astrid.App.ViewModels.csproj" />
  </ItemGroup>

</Project>
