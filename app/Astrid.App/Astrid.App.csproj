<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinUI 3 shell. Windows, XAML, key dispatch, platform adapters — and nothing else.

    Everything it draws is decided in astrid-core and arrives as a command response. If a file in
    this project ever needs to know what a row shows, which tasks belong in a list, or what
    completing one means, the answer belongs in the core and this project should be asking for it.
  -->
  <!--
    The words. One file per language under Strings/<tag>/; a translator adds a folder beside en-US
    and nothing else changes — the SDK picks up every .resw in the project on its own. Strings.cs
    holds the same English as a fallback for the build whose .pri does not make it next to the
    executable.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Astrid.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!--
      Unpackaged for now. MSIX arrives in M4 with the Store and the update feed; until then an
      unpackaged build is what a developer can run with F5 and what the UI smoke tests drive.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      The entry point is hand-written (Program.cs) so the app can be single-instance and receive
      the sign-in callback as a redirected activation. The generated one starts a second copy per
      launch, which for this app means a second copy with none of the flow state the first is
      waiting with.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astrid.Core.Bindings\Astrid.Core.Bindings.csproj" />
    <ProjectReference Include="..\Astrid.App.ViewModels\Astrid.App.ViewModels.csproj" />
  </ItemGroup>

</Project>
