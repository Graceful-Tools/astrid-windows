<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The converters live on the page rather than on the Grid inside it. `x:Bind` resolves a
        converter key against the ROOT element's resources only, so one declared on a nested Grid
        compiles, binds, and then throws "Cannot find a resource with the given key" the moment the
        page loads — with no line number and no element name.
    -->
    <UserControl.Resources>
        <local:PriorityBrushConverter x:Key="PriorityBrush" />
        <local:DepthIndentConverter x:Key="DepthIndent" />
        <local:BoolToVisibilityConverter x:Key="Visible" />
        <local:DueLabelConverter x:Key="DueText" />
        <local:PickTitleConverter x:Key="PickTitle" />
        <local:AssigneeNameConverter x:Key="AssigneeText" />
        <local:RepeatSummaryConverter x:Key="RepeatText" />
        <local:ReminderStateConverter x:Key="ReminderText" />
        <local:NotVisibleConverter x:Key="NotVisible" />
        <local:FilterStateConverter x:Key="FilterText" />
        <local:MessageBylineConverter x:Key="Byline" />
        <local:ColumnHeadingConverter x:Key="ColumnHeading" />
        <local:TimerButtonConverter x:Key="TimerText" />
        <local:StatConverter x:Key="StatFinished" Key="stats.completed" />
        <local:StatConverter x:Key="StatInspired" Key="stats.inspired" />
        <local:StatConverter x:Key="StatSupported" Key="stats.supported" />
        <local:LoggedTimeConverter x:Key="LoggedTime" />
        <local:CredentialStateConverter x:Key="CredentialState" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" KeyDown="OnKeyDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <!--
                    The conversation, then the detail pane. Auto rather than fixed widths so each
                    takes no space at all when it is shut, and the list gets the window back.
                -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!--
            The first run, once.

            Three things nobody can discover by looking: the global hotkey, the palette, and that
            the bare keys do anything. Everything else in this app is on screen, so this says those
            three and gets out of the way.
        -->
        <Grid x:Name="TourLayer"
              Grid.ColumnSpan="4"
              Canvas.ZIndex="20"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="{x:Bind Shell.IsTourOpen, Mode=OneWay, Converter={StaticResource Visible}}">
            <Border Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    Padding="24"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Three things worth knowing"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Ctrl+Shift+A brings Astrid forward from anywhere, ready for a new task." />
                    <TextBlock TextWrapping="Wrap"
                               Text="Ctrl+K finds a list, a task or a command." />
                    <TextBlock TextWrapping="Wrap"
                               Text="? lists every keyboard shortcut. They work without a modifier: n for a new task, x to finish one." />
                    <Button Content="Got it"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Got it"
                            Click="OnDismissTour"
                            Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            The command palette, over everything.

            Ctrl+K, which is what every other app with one uses. It spans the columns rather than
            sitting in one: it is not part of the layout, it is a thing that appears over it, and a
            palette that pushed the list sideways would be a panel.

            After the column definitions, not before them: a property element cannot follow a
            content child, and the XAML compiler answers that with exit code 1 and no message.
        -->
        <Grid x:Name="PaletteLayer"
              Grid.ColumnSpan="4"
              Canvas.ZIndex="10"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="{x:Bind Shell.IsPaletteOpen, Mode=OneWay, Converter={StaticResource Visible}}">
            <Border Width="560"
                    MaxHeight="440"
                    Margin="0,80,0,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    CornerRadius="8"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteBox"
                             Grid.Row="0"
                             PlaceholderText="Go to a list, open a task, run a command"
                             AutomationProperties.Name="Command palette"
                             TextChanged="OnPaletteChanged"
                             KeyDown="OnPaletteKeyDown" />
                    <ListView x:Name="PaletteList"
                              Grid.Row="1"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnPaletteRowChosen"
                              ItemsSource="{x:Bind Shell.PaletteRows, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="bindings:PaletteRow">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Trailing}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

            <!--
                The sign-in screen. It covers the app rather than replacing it, so the window does
                not have to tear down and rebuild the whole tree on the way in and out — and so
                signing out leaves an empty list behind it rather than a blank window.

                It sits AFTER the column definitions on purpose: in XAML a property element cannot
                follow a content child, and putting this first made the XAML compiler fail with no
                message at all — an hour of bisecting to find one ordering rule.
            -->
            <Grid x:Name="SignInLayer"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Canvas.ZIndex="10"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                  Visibility="{x:Bind Shell.SignIn.NeedsSignIn, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="12" MaxWidth="360">
                    <TextBlock Text="Astrid" Style="{ThemeResource TitleLargeTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Sign in with your browser. Passkeys, Google and magic links all work there, and you stay signed in here afterwards." />
                    <Button x:Name="SignInButton"
                            Content="Sign in with your browser"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnSignIn" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                Visibility="{x:Bind Shell.SignIn.IsWaitingForBrowser, Mode=OneWay, Converter={StaticResource Visible}}">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="Waiting for your browser…"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="Cancel" Click="OnCancelSignIn" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind Shell.SignIn.ErrorMessage, Mode=OneWay}"
                               Visibility="{x:Bind Shell.SignIn.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
    
            <!--
                The sidebar: favourites, then everything else.

                Collapsed while signed out rather than merely covered. An overlay hides it from the
                eye and leaves it in the tab order and in the accessibility tree, so a keyboard or
                screen-reader user can reach the previous session's lists from behind the sign-in
                screen.
            -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
    
                <TextBlock Grid.Row="0"
                           Text="Astrid"
                           Margin="16,16,16,8"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
    
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="8,0,8,8">
                        <TextBlock Text="Favourites"
                                   Margin="8,8,8,4"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Visibility="{x:Bind Shell.Sidebar.Favorites.Count, Mode=OneWay, Converter={StaticResource Visible}}" />
                        <ListView x:Name="FavoritesList"
                                  ItemsSource="{x:Bind Shell.Sidebar.Favorites, Mode=OneWay}"
                                  SelectionChanged="OnListSelected"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bindings:ListSummary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind DisplayColor, Converter={StaticResource PriorityBrush}}" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
    
                        <TextBlock Text="Lists"
                                   Margin="8,12,8,4"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                        <ListView x:Name="ListsList"
                                  ItemsSource="{x:Bind Shell.Sidebar.Lists, Mode=OneWay}"
                                  SelectionChanged="OnListSelected"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bindings:ListSummary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind DisplayColor, Converter={StaticResource PriorityBrush}}" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
    
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="12">
                    <TextBox x:Name="NewListBox"
                             PlaceholderText="New list"
                             Width="150"
                             KeyDown="OnNewListKeyDown" />
                    <Button Content="Add" Click="OnAddList" />
                </StackPanel>
            </Grid>
    
            <!-- The list itself. Collapsed while signed out, for the reason above. -->
            <Grid Grid.Column="1" Margin="0"
                  Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
    
                <Grid Grid.Row="0" Margin="20,16,20,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Shell.Tasks.ListName, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <!--
                            Search replaces what the list shows rather than opening a screen of its
                            own: the results are rows like any other, and they complete and open the
                            same way. A second surface that behaved almost-but-not-quite like the
                            list is how two code paths for one thing begin.
                        -->
                        <!--
                            What the list is filtered and sorted by. The values come from the core,
                            which is the only place they are matched on — a filter set here means
                            the same thing on web and on the Mac, because it is the same string.
                        -->
                        <Button x:Name="FilterButton"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Filters"
                                Content="{x:Bind Shell.Tasks.IsFiltered, Mode=OneWay, Converter={StaticResource FilterText}}">
                            <Button.Flyout>
                                <Flyout Opening="OnFiltersOpening">
                                    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{x:Bind Shell.Tasks.FilterGroups, Mode=OneWay}"
                                                      MinWidth="240">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bindings:FilterGroup">
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <ItemsControl ItemsSource="{x:Bind Picks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="bindings:FilterPick">
                                                                    <RadioButton Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}"
                                                                                 IsChecked="{x:Bind IsSelected}"
                                                                                 GroupName="{x:Bind Field}"
                                                                                 Checked="OnFilterChosen" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!--
                            The conversation about this list. A panel beside the tasks rather than
                            a screen of its own: it is about the work on the left, and reading it
                            should not mean losing sight of that.
                        -->
                        <ToggleButton x:Name="ChatToggle"
                                      Content="Chat"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Chat"
                                      IsChecked="{x:Bind Shell.IsChatOpen, Mode=OneWay}"
                                      Click="OnToggleChat" />
                        <!--
                            The list's own settings: its name, who it is shared with, and the way
                            out of it. Behind a button rather than always on screen, because it is
                            the thing somebody does once per list and never again.
                        -->
                        <Button x:Name="ListSettingsButton"
                                Content="List"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="List settings">
                            <Button.Flyout>
                                <Flyout Opening="OnListSettingsOpening">
                                    <StackPanel Spacing="8" MinWidth="320">
                                        <TextBlock Text="List settings"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBox x:Name="ListNameBox"
                                                 Header="Name"
                                                 AutomationProperties.Name="List name"
                                                 Text="{x:Bind Shell.ListSettings.Name, Mode=OneWay}"
                                                 LostFocus="OnListRenamed" />
                                        <!--
                                            Where this list is mirrored. Google and GitHub work
                                            differently and the rows say so, because "linked" means
                                            something different for each: GitHub is synced by the
                                            server whether or not this app runs, Google by this app
                                            when it does.
                                        -->
                                        <TextBlock Text="Mirrored to"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Margin="0,8,0,0" />
                                        <ItemsControl ItemsSource="{x:Bind Shell.ListSettings.Providers, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bindings:ExternalProvider">
                                                    <Grid ColumnSpacing="8" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{x:Bind Name}"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  PlaceholderText="Not mirrored"
                                                                  AutomationProperties.Name="{x:Bind Name}"
                                                                  Tag="{x:Bind Provider}"
                                                                  ItemsSource="{x:Bind Containers}"
                                                                  SelectionChanged="OnMirrorChosen"
                                                                  Visibility="{x:Bind Connected, Converter={StaticResource Visible}}" />
                                                        <Button Grid.Column="2"
                                                                Content="Connect"
                                                                Tag="{x:Bind Provider}"
                                                                Click="OnConnectProvider"
                                                                Visibility="{x:Bind Connected, Converter={StaticResource NotVisible}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Shared with"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Margin="0,8,0,0" />
                                        <ItemsControl ItemsSource="{x:Bind Shell.ListSettings.Members, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bindings:ListMember">
                                                    <Grid ColumnSpacing="8" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{x:Bind DisplayName}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind RoleKey, Converter={StaticResource PickTitle}}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                        <Button Grid.Column="2"
                                                                Content="Remove"
                                                                Tag="{x:Bind UserId}"
                                                                Click="OnRemoveMember" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Visibility="{x:Bind Shell.ListSettings.CanManageMembers, Mode=OneWay, Converter={StaticResource Visible}}">
                                            <TextBox x:Name="InviteBox"
                                                     Width="200"
                                                     PlaceholderText="Invite by email"
                                                     AutomationProperties.Name="Invite by email"
                                                     KeyDown="OnInviteKeyDown" />
                                            <Button Content="Invite" Click="OnInvite" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <Button Content="Leave list"
                                                    Click="OnLeaveList"
                                                    Visibility="{x:Bind Shell.ListSettings.CanLeave, Mode=OneWay, Converter={StaticResource Visible}}" />
                                            <!--
                                                Deleting asks first. It takes the list away from
                                                everybody it is shared with, and there is no undo
                                                for that on any client.
                                            -->
                                            <Button Content="Delete list"
                                                    Visibility="{x:Bind Shell.ListSettings.CanDeleteList, Mode=OneWay, Converter={StaticResource Visible}}">
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="8" MaxWidth="260">
                                                            <TextBlock TextWrapping="Wrap"
                                                                       Text="Delete this list and its tasks, for everybody it is shared with?" />
                                                            <Button Content="Delete it"
                                                                    Click="OnDeleteList"
                                                                    Style="{ThemeResource AccentButtonStyle}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Bind Shell.ListSettings.ErrorMessage, Mode=OneWay}"
                                                   Visibility="{x:Bind Shell.ListSettings.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!--
                            The board and the list are two views of one list's work, not two
                            screens: the toggle swaps what is drawn and nothing else moves.
                        -->
                        <ToggleButton x:Name="BoardToggle"
                                      Content="Board"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Board view"
                                      IsChecked="{x:Bind Shell.IsBoardView, Mode=OneWay}"
                                      Click="OnToggleBoard" />
                        <AutoSuggestBox x:Name="SearchBox"
                                        Width="220"
                                        VerticalAlignment="Center"
                                        QueryIcon="Find"
                                        PlaceholderText="Search tasks"
                                        AutomationProperties.Name="Search tasks"
                                        TextChanged="OnSearchChanged" />
                    </StackPanel>
                    <!-- Not synced yet. Quiet, because it is a normal state and not a problem. -->
                    <TextBlock Grid.Column="1"
                               Text="Not synced yet"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind Shell.HasUnsentWork, Mode=OneWay, Converter={StaticResource Visible}}" />
                    <!--
                        The account. A flyout rather than a page: it is four toggles and a name,
                        and a screen you have to navigate back out of is a screen people avoid.
                    -->
                    <Button Grid.Column="2"
                            Content="Account"
                            AutomationProperties.Name="Account"
                            Margin="0,0,8,0">
                        <Button.Flyout>
                            <Flyout Opening="OnAccountOpening">
                                <StackPanel Spacing="8" MinWidth="300">
                                    <TextBlock Text="{x:Bind Shell.Settings.DisplayName, Mode=OneWay}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Shell.Settings.Email, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <!--
                                        The three numbers, from the server: they are about the
                                        whole account across every device, so a client counting its
                                        own cache would answer with whatever it happens to hold.
                                    -->
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind Shell.Settings.Stats, Mode=OneWay, Converter={StaticResource StatFinished}}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Shell.Settings.Stats, Mode=OneWay, Converter={StaticResource StatInspired}}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Shell.Settings.Stats, Mode=OneWay, Converter={StaticResource StatSupported}}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>

                                    <TextBlock Text="Reminders" Margin="0,8,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ToggleSwitch x:Name="PushToggle"
                                                  Header="Push reminders"
                                                  AutomationProperties.Name="Push reminders"
                                                  IsOn="{x:Bind Shell.Settings.PushEnabled, Mode=OneWay}"
                                                  Toggled="OnPushToggled" />
                                    <ToggleSwitch x:Name="EmailToggle"
                                                  Header="Email reminders"
                                                  AutomationProperties.Name="Email reminders"
                                                  IsOn="{x:Bind Shell.Settings.EmailEnabled, Mode=OneWay}"
                                                  Toggled="OnEmailToggled" />
                                    <ComboBox x:Name="DefaultOffsetBox"
                                              Header="Remind me by default"
                                              AutomationProperties.Name="Default reminder"
                                              ItemsSource="{x:Bind Shell.Settings.Offsets, Mode=OneWay}"
                                              SelectionChanged="OnDefaultOffsetChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="bindings:ReminderOffset">
                                                <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="Daily digest" Margin="0,8,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ToggleSwitch x:Name="DigestToggle"
                                                  Header="Send a daily digest"
                                                  AutomationProperties.Name="Daily digest"
                                                  IsOn="{x:Bind Shell.Settings.DigestEnabled, Mode=OneWay}"
                                                  Toggled="OnDigestToggled" />
                                    <TimePicker x:Name="DigestTimeBox"
                                                Header="At"
                                                AutomationProperties.Name="Digest time"
                                                SelectedTimeChanged="OnDigestTimeChanged" />

                                    <TextBlock Text="Quiet hours" Margin="0,8,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ToggleSwitch x:Name="QuietToggle"
                                                  Header="No reminders overnight"
                                                  AutomationProperties.Name="Quiet hours"
                                                  IsOn="{x:Bind Shell.Settings.QuietHoursEnabled, Mode=OneWay}"
                                                  Toggled="OnQuietHoursToggled" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TimePicker x:Name="QuietStartBox" Header="From"
                                                    AutomationProperties.Name="Quiet from"
                                                    SelectedTimeChanged="OnQuietHoursChanged" />
                                        <TimePicker x:Name="QuietEndBox" Header="Until"
                                                    AutomationProperties.Name="Quiet until"
                                                    SelectedTimeChanged="OnQuietHoursChanged" />
                                    </StackPanel>

                                    <!--
                                        The agents. "api" is Astrid running them and needs nothing
                                        set up; "polling" and "webhook" are the account's own agent
                                        and need a key, which is why the two are drawn together.
                                    -->
                                    <TextBlock Text="Agents" Margin="0,8,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind Shell.Settings.Agents, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="bindings:AgentSummary">
                                                <Grid ColumnSpacing="8" Padding="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                               VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              AutomationProperties.Name="{x:Bind Name}"
                                                              Tag="{x:Bind Id}"
                                                              SelectedItem="{x:Bind Mode}"
                                                              SelectionChanged="OnAgentModeChosen">
                                                        <x:String>api</x:String>
                                                        <x:String>polling</x:String>
                                                        <x:String>webhook</x:String>
                                                        <x:String>off</x:String>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{x:Bind Shell.Settings.Credentials, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="bindings:AgentCredential">
                                                <Grid ColumnSpacing="8" Padding="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                               VerticalAlignment="Center" />
                                                    <!--
                                                        Empty even when a key is stored: the server
                                                        answers with which services are set up and
                                                        never with the key, so there is nothing to
                                                        put in it.
                                                    -->
                                                    <PasswordBox Grid.Column="1"
                                                                 PlaceholderText="Paste a key, then Enter"
                                                                 AutomationProperties.Name="{x:Bind Name}"
                                                                 Tag="{x:Bind ServiceId}"
                                                                 KeyDown="OnCredentialKeyDown" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind Configured, Converter={StaticResource CredentialState}}"
                                                               VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Connect Copilot"
                                                Click="OnConnectCopilot"
                                                Visibility="{x:Bind Shell.Settings.CopilotConnected, Mode=OneWay, Converter={StaticResource NotVisible}}" />
                                        <Button Content="Disconnect Copilot"
                                                Click="OnDisconnectCopilot"
                                                Visibility="{x:Bind Shell.Settings.CopilotConnected, Mode=OneWay, Converter={StaticResource Visible}}" />
                                    </StackPanel>

                                    <TextBlock Text="Your data" Margin="0,8,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Export as JSON" Tag="json"
                                                Click="OnExportAccount" />
                                        <Button Content="Export as CSV" Tag="csv"
                                                Click="OnExportAccount" />
                                    </StackPanel>
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{x:Bind Shell.Settings.LastExportPath, Mode=OneWay}"
                                               Visibility="{x:Bind Shell.Settings.LastExportPath, Mode=OneWay, Converter={StaticResource Visible}}" />

                                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Text="{x:Bind Shell.Settings.ErrorMessage, Mode=OneWay}"
                                               Visibility="{x:Bind Shell.Settings.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Content="Sync" Click="OnSync" HorizontalAlignment="Right" />
                <Button Grid.Column="3" Content="Sign out" Click="OnSignOut" />
                </Grid>
    
                <!--
                    The selection is two-way. The keyboard moves it in the view model and the list
                    has to follow; clicking a row moves it in the list and the keyboard has to
                    follow. One binding rather than two handlers keeping each other in step.
                -->
                <!--
                    The board. One column per status, cards inside them, and a menu on each card to
                    move it — a drag is the gesture people expect, and it will come, but a card that
                    can only be dragged is a card a keyboard cannot move at all.
                -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled"
                              Margin="12,0"
                              Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{x:Bind Shell.Board.Columns, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bindings:BoardColumn">
                                <!--
                                    A column takes a dropped card. The menu on each card does the
                                    same thing and is what a keyboard can reach; the drag is what
                                    everybody expects from a board.
                                -->
                                <Border Width="280"
                                        Padding="12"
                                        CornerRadius="8"
                                        AllowDrop="True"
                                        Tag="{x:Bind Id}"
                                        DragOver="OnCardDragOver"
                                        Drop="OnCardDropped"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Converter={StaticResource ColumnHeading}}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind Cards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bindings:TaskRow">
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Margin="0,4,0,0"
                                                            Tag="{x:Bind Id}"
                                                            AutomationProperties.Name="{x:Bind Title}"
                                                            CanDrag="True"
                                                            DragStarting="OnCardDragStarting"
                                                            Click="OnCardOpened"
                                                            RightTapped="OnCardRightTapped">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind Due, Converter={StaticResource DueText}}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ListView Grid.Row="1"
                          Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource NotVisible}}"
                          x:Name="TaskRows"
                          Margin="8,0,8,0"
                          ItemsSource="{x:Bind Shell.Tasks.Rows, Mode=OneWay}"
                          SelectedItem="{x:Bind Shell.Tasks.Selected, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnRowSelected"
                          ShowsScrollingPlaceholders="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="bindings:TaskRow">
                            <Grid ColumnSpacing="10" Padding="0,4"
                                  Margin="{x:Bind Depth, Converter={StaticResource DepthIndent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
    
                                <CheckBox Grid.Column="0"
                                          MinWidth="0"
                                          AutomationProperties.Name="{x:Bind CompleteActionName}"
                                          IsChecked="{x:Bind Completed}"
                                          Tag="{x:Bind Id}"
                                          Checked="OnRowChecked"
                                          Unchecked="OnRowUnchecked" />
    
                                <!-- Priority reads as a stripe rather than a word: it is glanceable. -->
                                <Border Grid.Column="1"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="{x:Bind Priority, Converter={StaticResource PriorityBrush}}" />
    
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Due, Converter={StaticResource DueText}}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind Due.HasDate, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="Not synced yet"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind IsPending, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </StackPanel>
    
                                <Button Grid.Column="3"
                                        Content="Delete"
                                        AutomationProperties.Name="{x:Bind DeleteActionName}"
                                        Tag="{x:Bind Id}"
                                        Click="OnDeleteRow" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
    
                <TextBlock Grid.Row="2"
                           Margin="20,4"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{x:Bind Shell.Tasks.ErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind Shell.Tasks.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
    
                <!-- Quick add. One control, at the bottom, where the eye ends up after reading a list. -->
                <Grid Grid.Row="3" Margin="20,8,20,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickAddBox"
                             Grid.Column="0"
                             PlaceholderText="Add a task"
                             KeyDown="OnQuickAddKeyDown" />
                    <Button Grid.Column="1" Content="Add" Click="OnQuickAdd" Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </Grid>

        <!--
            The conversation. Beside the list, and collapsed rather than narrow when it is shut, so
            it is out of the tab order as well as out of the way.
        -->
        <Grid Grid.Column="2" Width="320" Padding="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind Shell.IsChatOpen, Mode=OneWay, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Chat" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8">
                <ItemsControl ItemsSource="{x:Bind Shell.Chat.Messages, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bindings:MessageRow">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{x:Bind Converter={StaticResource Byline}}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind IsSystem, Converter={StaticResource NotVisible}}" />
                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Text="{x:Bind Shell.Chat.ErrorMessage, Mode=OneWay}"
                       Visibility="{x:Bind Shell.Chat.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
            <TextBox Grid.Row="3"
                     x:Name="ChatBox"
                     PlaceholderText="Say something"
                     AutomationProperties.Name="Message"
                     IsEnabled="{x:Bind Shell.Chat.HasChannel, Mode=OneWay}"
                     KeyDown="OnChatKeyDown" />
        </Grid>

        <!--
            The task detail. Collapsed rather than merely narrow when nothing is open, so it is out
            of the tab order as well as out of the way.

            The rows are laid out in the order the core gave — Who, Date, Priority, Lists — which
            is a product decision shared with web and both Apple clients. It is not re-decided here.
        -->
        <Grid Grid.Column="3" Width="340" Padding="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind Shell.Detail.IsOpen, Mode=OneWay, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" MinWidth="0"
                              AutomationProperties.Name="Complete this task"
                              IsChecked="{x:Bind Shell.Detail.Completed, Mode=OneWay}"
                              Checked="OnDetailChecked" Unchecked="OnDetailUnchecked" />
                    <TextBox Grid.Column="1" x:Name="DetailTitleBox"
                             AutomationProperties.Name="Title"
                             Text="{x:Bind Shell.Detail.Title, Mode=TwoWay}"
                             LostFocus="OnDetailTitleCommitted"
                             KeyDown="OnDetailTitleKeyDown" />
                    <Button Grid.Column="2" Content="Close" Click="OnCloseDetail" />
                </Grid>

                <!--
                    Who holds the task. First, because the field order — Who, Date, Priority,
                    Lists — is a product decision shared with web and both Apple clients.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Assignee">
                    <TextBlock Text="{x:Bind Shell.Detail.Assignee, Mode=OneWay, Converter={StaticResource AssigneeText}}" />
                    <Button.Flyout>
                        <Flyout Opening="OnAssigneeFlyoutOpening">
                            <ItemsControl ItemsSource="{x:Bind Shell.Detail.Assignees, Mode=OneWay}"
                                          MinWidth="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:AssigneeOption">
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Tag="{x:Bind UserId}"
                                                Click="OnAssigneeChosen">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Glyph}"
                                                           Width="24" TextAlignment="Center" />
                                                <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    The due date. A button rather than a label, because the date is the field a
                    task app is most often opened to change, and the quick choices behind it come
                    from the core with the instant each one means already worked out.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Due date">
                    <TextBlock Text="{x:Bind Shell.Detail.Due, Mode=OneWay, Converter={StaticResource DueText}}" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="4" MinWidth="200">
                                <TextBlock Text="When" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Shell.Detail.DatePicks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:DuePick">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{x:Bind TitleKey}"
                                                    Click="OnDuePickChosen"
                                                    Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Time" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{x:Bind Shell.Detail.TimePicks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:DuePick">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{x:Bind TitleKey}"
                                                    Click="OnDuePickChosen"
                                                    Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    When to be reminded. The instants come from the core with the choices, so the
                    shell never subtracts an hour from a date itself.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Reminder">
                    <TextBlock Text="{x:Bind Shell.Detail.HasReminder, Mode=OneWay, Converter={StaticResource ReminderText}}" />
                    <Button.Flyout>
                        <Flyout Opening="OnReminderFlyoutOpening">
                            <ItemsControl ItemsSource="{x:Bind Shell.Detail.ReminderPicks, Mode=OneWay}"
                                          MinWidth="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:ReminderPick">
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Tag="{x:Bind ReminderTime}"
                                                Click="OnReminderChosen"
                                                Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    How the task repeats. The summary is the picker's own sentence rather than a
                    chip saying "Custom", which says nothing about when the task comes back.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Repeat">
                    <TextBlock Text="{x:Bind Shell.Detail.RepeatSummary, Mode=OneWay, Converter={StaticResource RepeatText}}" />
                    <Button.Flyout>
                        <Flyout Opening="OnRepeatFlyoutOpening">
                            <StackPanel Spacing="4" MinWidth="260">
                                <ItemsControl ItemsSource="{x:Bind Shell.Detail.RepeatPresets, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:RepeatPreset">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{x:Bind Value}"
                                                    Click="OnRepeatPresetChosen"
                                                    Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ToggleSwitch x:Name="RepeatFromDueDate"
                                              Header="Count from the due date"
                                              OnContent="Due date" OffContent="When finished"
                                              IsOn="{x:Bind Shell.Detail.RepeatsFromDueDate, Mode=OneWay}"
                                              Toggled="OnRepeatFromToggled" />
                                <TextBlock Text="Custom" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="RepeatInterval" Value="1" Minimum="1" Maximum="365"
                                               Width="96" AutomationProperties.Name="Every" />
                                    <ComboBox x:Name="RepeatUnit" SelectedIndex="0"
                                              AutomationProperties.Name="Unit">
                                        <ComboBoxItem Content="days" Tag="days" />
                                        <ComboBoxItem Content="weeks" Tag="weeks" />
                                        <ComboBoxItem Content="months" Tag="months" />
                                        <ComboBoxItem Content="years" Tag="years" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="RepeatWeekdays" Orientation="Horizontal" Spacing="2">
                                    <ToggleButton Content="M" Tag="monday" MinWidth="32" />
                                    <ToggleButton Content="T" Tag="tuesday" MinWidth="32" />
                                    <ToggleButton Content="W" Tag="wednesday" MinWidth="32" />
                                    <ToggleButton Content="T" Tag="thursday" MinWidth="32" />
                                    <ToggleButton Content="F" Tag="friday" MinWidth="32" />
                                    <ToggleButton Content="S" Tag="saturday" MinWidth="32" />
                                    <ToggleButton Content="S" Tag="sunday" MinWidth="32" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="RepeatEnd" SelectedIndex="0"
                                              AutomationProperties.Name="Ends">
                                        <ComboBoxItem Content="never ends" Tag="never" />
                                        <ComboBoxItem Content="ends after" Tag="after_occurrences" />
                                        <ComboBoxItem Content="ends on" Tag="until_date" />
                                    </ComboBox>
                                    <NumberBox x:Name="RepeatEndCount" Value="10" Minimum="1" Maximum="999"
                                               Width="86" AutomationProperties.Name="Occurrences" />
                                    <CalendarDatePicker x:Name="RepeatEndDate"
                                                        AutomationProperties.Name="Ends on" />
                                </StackPanel>
                                <Button Content="Save custom repeat" Click="OnCustomRepeatSaved" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Shell.Detail.PriorityGlyph, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{x:Bind Shell.Detail.Priority, Mode=OneWay, Converter={StaticResource PriorityBrush}}" />
                    <ComboBox x:Name="DetailPriority"
                              AutomationProperties.Name="Priority"
                              SelectionChanged="OnDetailPriorityChanged">
                        <ComboBoxItem Content="No priority" />
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="High" />
                    </ComboBox>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind Shell.Detail.ListChips, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bindings:ListChip">
                            <Border CornerRadius="4" Padding="6,2" Margin="0,2,4,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="DetailDescriptionBox"
                         AutomationProperties.Name="Description"
                         PlaceholderText="Notes"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         Text="{x:Bind Shell.Detail.Description, Mode=TwoWay}"
                         LostFocus="OnDetailDescriptionCommitted" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Subtasks" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Shell.Detail.Subtasks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SubtaskSummary">
                                <TextBlock Text="{x:Bind Title}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="SubtaskBox" PlaceholderText="Add a subtask"
                             KeyDown="OnSubtaskKeyDown" />

                    <!--
                        The timer. Visible while it runs, and a caption once it has recorded
                        something, so hiding the section never hides the data.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="TimerButton"
                                Content="{x:Bind Shell.Detail.IsTiming, Mode=OneWay, Converter={StaticResource TimerText}}"
                                AutomationProperties.Name="Timer"
                                Click="OnToggleTimer" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind Shell.Detail.Timer, Mode=OneWay, Converter={StaticResource LoggedTime}}"
                                   Visibility="{x:Bind Shell.Detail.HasLoggedTime, Mode=OneWay, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <TextBlock Text="Attachments" Style="{ThemeResource CaptionTextBlockStyle}"
                               Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{x:Bind Shell.Detail.Attachments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bindings:AttachmentSummary">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeLabel}"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            Tag="{x:Bind Id}"
                                            Click="OnOpenAttachment" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Attach a file" Click="OnAttachFile" Margin="0,4,0,0" />

                    <TextBlock Text="Comments" Style="{ThemeResource CaptionTextBlockStyle}"
                               Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{x:Bind Shell.Detail.Comments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CommentSummary">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" />
                                    <TextBlock Text="Not synced yet"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind IsPending, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
                <TextBox x:Name="CommentBox" PlaceholderText="Add a comment"
                         KeyDown="OnCommentKeyDown" />
                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Bind Shell.Detail.ErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind Shell.Detail.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Grid>
        </Grid>
</UserControl>
