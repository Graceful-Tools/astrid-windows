<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The converters live on the page rather than on the Grid inside it. `x:Bind` resolves a
        converter key against the ROOT element's resources only, so one declared on a nested Grid
        compiles, binds, and then throws "Cannot find a resource with the given key" the moment the
        page loads — with no line number and no element name.
    -->
    <UserControl.Resources>
        <local:PriorityBrushConverter x:Key="PriorityBrush" />
        <local:DepthIndentConverter x:Key="DepthIndent" />
        <local:BoolToVisibilityConverter x:Key="Visible" />
        <local:DueLabelConverter x:Key="DueText" />
        <local:PickTitleConverter x:Key="PickTitle" />
        <local:AssigneeNameConverter x:Key="AssigneeText" />
        <local:RepeatSummaryConverter x:Key="RepeatText" />
        <local:ReminderStateConverter x:Key="ReminderText" />
        <local:NotVisibleConverter x:Key="NotVisible" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" KeyDown="OnKeyDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <!--
                    The detail pane. Auto rather than a fixed width so it takes no space at all
                    when nothing is open, and the list gets the whole window back.
                -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The sign-in screen. It covers the app rather than replacing it, so the window does
                not have to tear down and rebuild the whole tree on the way in and out — and so
                signing out leaves an empty list behind it rather than a blank window.

                It sits AFTER the column definitions on purpose: in XAML a property element cannot
                follow a content child, and putting this first made the XAML compiler fail with no
                message at all — an hour of bisecting to find one ordering rule.
            -->
            <Grid x:Name="SignInLayer"
                  Grid.Column="0" Grid.ColumnSpan="3"
                  Canvas.ZIndex="10"
                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                  Visibility="{x:Bind Shell.SignIn.NeedsSignIn, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="12" MaxWidth="360">
                    <TextBlock Text="Astrid" Style="{ThemeResource TitleLargeTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Sign in with your browser. Passkeys, Google and magic links all work there, and you stay signed in here afterwards." />
                    <Button x:Name="SignInButton"
                            Content="Sign in with your browser"
                            HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnSignIn" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                Visibility="{x:Bind Shell.SignIn.IsWaitingForBrowser, Mode=OneWay, Converter={StaticResource Visible}}">
                        <ProgressRing IsActive="True" Width="16" Height="16" />
                        <TextBlock Text="Waiting for your browser…"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Content="Cancel" Click="OnCancelSignIn" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Text="{x:Bind Shell.SignIn.ErrorMessage, Mode=OneWay}"
                               Visibility="{x:Bind Shell.SignIn.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
    
            <!--
                The sidebar: favourites, then everything else.

                Collapsed while signed out rather than merely covered. An overlay hides it from the
                eye and leaves it in the tab order and in the accessibility tree, so a keyboard or
                screen-reader user can reach the previous session's lists from behind the sign-in
                screen.
            -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
    
                <TextBlock Grid.Row="0"
                           Text="Astrid"
                           Margin="16,16,16,8"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
    
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="8,0,8,8">
                        <TextBlock Text="Favourites"
                                   Margin="8,8,8,4"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Visibility="{x:Bind Shell.Sidebar.Favorites.Count, Mode=OneWay, Converter={StaticResource Visible}}" />
                        <ListView x:Name="FavoritesList"
                                  ItemsSource="{x:Bind Shell.Sidebar.Favorites, Mode=OneWay}"
                                  SelectionChanged="OnListSelected"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bindings:ListSummary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind DisplayColor, Converter={StaticResource PriorityBrush}}" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
    
                        <TextBlock Text="Lists"
                                   Margin="8,12,8,4"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                        <ListView x:Name="ListsList"
                                  ItemsSource="{x:Bind Shell.Sidebar.Lists, Mode=OneWay}"
                                  SelectionChanged="OnListSelected"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="bindings:ListSummary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind DisplayColor, Converter={StaticResource PriorityBrush}}" />
                                        <TextBlock Text="{x:Bind Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
    
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="12">
                    <TextBox x:Name="NewListBox"
                             PlaceholderText="New list"
                             Width="150"
                             KeyDown="OnNewListKeyDown" />
                    <Button Content="Add" Click="OnAddList" />
                </StackPanel>
            </Grid>
    
            <!-- The list itself. Collapsed while signed out, for the reason above. -->
            <Grid Grid.Column="1" Margin="0"
                  Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
    
                <Grid Grid.Row="0" Margin="20,16,20,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Shell.Tasks.ListName, Mode=OneWay}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <!--
                            Search replaces what the list shows rather than opening a screen of its
                            own: the results are rows like any other, and they complete and open the
                            same way. A second surface that behaved almost-but-not-quite like the
                            list is how two code paths for one thing begin.
                        -->
                        <!--
                            The board and the list are two views of one list's work, not two
                            screens: the toggle swaps what is drawn and nothing else moves.
                        -->
                        <ToggleButton x:Name="BoardToggle"
                                      Content="Board"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Board view"
                                      IsChecked="{x:Bind Shell.IsBoardView, Mode=OneWay}"
                                      Click="OnToggleBoard" />
                        <AutoSuggestBox x:Name="SearchBox"
                                        Width="220"
                                        VerticalAlignment="Center"
                                        QueryIcon="Find"
                                        PlaceholderText="Search tasks"
                                        AutomationProperties.Name="Search tasks"
                                        TextChanged="OnSearchChanged" />
                    </StackPanel>
                    <!-- Not synced yet. Quiet, because it is a normal state and not a problem. -->
                    <TextBlock Grid.Column="1"
                               Text="Not synced yet"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind Shell.HasUnsentWork, Mode=OneWay, Converter={StaticResource Visible}}" />
                    <Button Grid.Column="2" Content="Sync" Click="OnSync" />
                <Button Grid.Column="3" Content="Sign out" Click="OnSignOut" />
                </Grid>
    
                <!--
                    The selection is two-way. The keyboard moves it in the view model and the list
                    has to follow; clicking a row moves it in the list and the keyboard has to
                    follow. One binding rather than two handlers keeping each other in step.
                -->
                <!--
                    The board. One column per status, cards inside them, and a menu on each card to
                    move it — a drag is the gesture people expect, and it will come, but a card that
                    can only be dragged is a card a keyboard cannot move at all.
                -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled"
                              Margin="12,0"
                              Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource Visible}}">
                    <ItemsControl ItemsSource="{x:Bind Shell.Board.Columns, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="bindings:BoardColumn">
                                <Border Width="280"
                                        Padding="12"
                                        CornerRadius="8"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Heading}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind Cards}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bindings:TaskRow">
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Margin="0,4,0,0"
                                                            Tag="{x:Bind Id}"
                                                            Click="OnCardOpened"
                                                            RightTapped="OnCardRightTapped">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind Due, Converter={StaticResource DueText}}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ListView Grid.Row="1"
                          Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource NotVisible}}"
                          x:Name="TaskRows"
                          Margin="8,0,8,0"
                          ItemsSource="{x:Bind Shell.Tasks.Rows, Mode=OneWay}"
                          SelectedItem="{x:Bind Shell.Tasks.Selected, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnRowSelected"
                          ShowsScrollingPlaceholders="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="bindings:TaskRow">
                            <Grid ColumnSpacing="10" Padding="0,4"
                                  Margin="{x:Bind Depth, Converter={StaticResource DepthIndent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
    
                                <CheckBox Grid.Column="0"
                                          MinWidth="0"
                                          AutomationProperties.Name="{x:Bind CompleteActionName}"
                                          IsChecked="{x:Bind Completed}"
                                          Tag="{x:Bind Id}"
                                          Checked="OnRowChecked"
                                          Unchecked="OnRowUnchecked" />
    
                                <!-- Priority reads as a stripe rather than a word: it is glanceable. -->
                                <Border Grid.Column="1"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="{x:Bind Priority, Converter={StaticResource PriorityBrush}}" />
    
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Due, Converter={StaticResource DueText}}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind Due.HasDate, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="Not synced yet"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind IsPending, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </StackPanel>
    
                                <Button Grid.Column="3"
                                        Content="Delete"
                                        AutomationProperties.Name="{x:Bind DeleteActionName}"
                                        Tag="{x:Bind Id}"
                                        Click="OnDeleteRow" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
    
                <TextBlock Grid.Row="2"
                           Margin="20,4"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{x:Bind Shell.Tasks.ErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind Shell.Tasks.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
    
                <!-- Quick add. One control, at the bottom, where the eye ends up after reading a list. -->
                <Grid Grid.Row="3" Margin="20,8,20,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickAddBox"
                             Grid.Column="0"
                             PlaceholderText="Add a task"
                             KeyDown="OnQuickAddKeyDown" />
                    <Button Grid.Column="1" Content="Add" Click="OnQuickAdd" Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </Grid>

        <!--
            The task detail. Collapsed rather than merely narrow when nothing is open, so it is out
            of the tab order as well as out of the way.

            The rows are laid out in the order the core gave — Who, Date, Priority, Lists — which
            is a product decision shared with web and both Apple clients. It is not re-decided here.
        -->
        <Grid Grid.Column="2" Width="340" Padding="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind Shell.Detail.IsOpen, Mode=OneWay, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" MinWidth="0"
                              AutomationProperties.Name="Complete this task"
                              IsChecked="{x:Bind Shell.Detail.Completed, Mode=OneWay}"
                              Checked="OnDetailChecked" Unchecked="OnDetailUnchecked" />
                    <TextBox Grid.Column="1" x:Name="DetailTitleBox"
                             AutomationProperties.Name="Title"
                             Text="{x:Bind Shell.Detail.Title, Mode=TwoWay}"
                             LostFocus="OnDetailTitleCommitted"
                             KeyDown="OnDetailTitleKeyDown" />
                    <Button Grid.Column="2" Content="Close" Click="OnCloseDetail" />
                </Grid>

                <!--
                    Who holds the task. First, because the field order — Who, Date, Priority,
                    Lists — is a product decision shared with web and both Apple clients.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Assignee">
                    <TextBlock Text="{x:Bind Shell.Detail.Assignee, Mode=OneWay, Converter={StaticResource AssigneeText}}" />
                    <Button.Flyout>
                        <Flyout Opening="OnAssigneeFlyoutOpening">
                            <ItemsControl ItemsSource="{x:Bind Shell.Detail.Assignees, Mode=OneWay}"
                                          MinWidth="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:AssigneeOption">
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Tag="{x:Bind UserId}"
                                                Click="OnAssigneeChosen">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Glyph}"
                                                           Width="24" TextAlignment="Center" />
                                                <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    The due date. A button rather than a label, because the date is the field a
                    task app is most often opened to change, and the quick choices behind it come
                    from the core with the instant each one means already worked out.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Due date">
                    <TextBlock Text="{x:Bind Shell.Detail.Due, Mode=OneWay, Converter={StaticResource DueText}}" />
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="4" MinWidth="200">
                                <TextBlock Text="When" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Shell.Detail.DatePicks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:DuePick">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{x:Bind TitleKey}"
                                                    Click="OnDuePickChosen"
                                                    Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Time" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{x:Bind Shell.Detail.TimePicks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:DuePick">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{x:Bind TitleKey}"
                                                    Click="OnDuePickChosen"
                                                    Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    When to be reminded. The instants come from the core with the choices, so the
                    shell never subtracts an hour from a date itself.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Reminder">
                    <TextBlock Text="{x:Bind Shell.Detail.HasReminder, Mode=OneWay, Converter={StaticResource ReminderText}}" />
                    <Button.Flyout>
                        <Flyout Opening="OnReminderFlyoutOpening">
                            <ItemsControl ItemsSource="{x:Bind Shell.Detail.ReminderPicks, Mode=OneWay}"
                                          MinWidth="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:ReminderPick">
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Tag="{x:Bind ReminderTime}"
                                                Click="OnReminderChosen"
                                                Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    How the task repeats. The summary is the picker's own sentence rather than a
                    chip saying "Custom", which says nothing about when the task comes back.
                -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="Repeat">
                    <TextBlock Text="{x:Bind Shell.Detail.RepeatSummary, Mode=OneWay, Converter={StaticResource RepeatText}}" />
                    <Button.Flyout>
                        <Flyout Opening="OnRepeatFlyoutOpening">
                            <StackPanel Spacing="4" MinWidth="260">
                                <ItemsControl ItemsSource="{x:Bind Shell.Detail.RepeatPresets, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:RepeatPreset">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Tag="{x:Bind Value}"
                                                    Click="OnRepeatPresetChosen"
                                                    Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ToggleSwitch x:Name="RepeatFromDueDate"
                                              Header="Count from the due date"
                                              OnContent="Due date" OffContent="When finished"
                                              IsOn="{x:Bind Shell.Detail.RepeatsFromDueDate, Mode=OneWay}"
                                              Toggled="OnRepeatFromToggled" />
                                <TextBlock Text="Custom" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="RepeatInterval" Value="1" Minimum="1" Maximum="365"
                                               Width="96" AutomationProperties.Name="Every" />
                                    <ComboBox x:Name="RepeatUnit" SelectedIndex="0"
                                              AutomationProperties.Name="Unit">
                                        <ComboBoxItem Content="days" Tag="days" />
                                        <ComboBoxItem Content="weeks" Tag="weeks" />
                                        <ComboBoxItem Content="months" Tag="months" />
                                        <ComboBoxItem Content="years" Tag="years" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="RepeatWeekdays" Orientation="Horizontal" Spacing="2">
                                    <ToggleButton Content="M" Tag="monday" MinWidth="32" />
                                    <ToggleButton Content="T" Tag="tuesday" MinWidth="32" />
                                    <ToggleButton Content="W" Tag="wednesday" MinWidth="32" />
                                    <ToggleButton Content="T" Tag="thursday" MinWidth="32" />
                                    <ToggleButton Content="F" Tag="friday" MinWidth="32" />
                                    <ToggleButton Content="S" Tag="saturday" MinWidth="32" />
                                    <ToggleButton Content="S" Tag="sunday" MinWidth="32" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="RepeatEnd" SelectedIndex="0"
                                              AutomationProperties.Name="Ends">
                                        <ComboBoxItem Content="never ends" Tag="never" />
                                        <ComboBoxItem Content="ends after" Tag="after_occurrences" />
                                        <ComboBoxItem Content="ends on" Tag="until_date" />
                                    </ComboBox>
                                    <NumberBox x:Name="RepeatEndCount" Value="10" Minimum="1" Maximum="999"
                                               Width="86" AutomationProperties.Name="Occurrences" />
                                    <CalendarDatePicker x:Name="RepeatEndDate"
                                                        AutomationProperties.Name="Ends on" />
                                </StackPanel>
                                <Button Content="Save custom repeat" Click="OnCustomRepeatSaved" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Shell.Detail.PriorityGlyph, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{x:Bind Shell.Detail.Priority, Mode=OneWay, Converter={StaticResource PriorityBrush}}" />
                    <ComboBox x:Name="DetailPriority"
                              AutomationProperties.Name="Priority"
                              SelectionChanged="OnDetailPriorityChanged">
                        <ComboBoxItem Content="No priority" />
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="High" />
                    </ComboBox>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind Shell.Detail.ListChips, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bindings:ListChip">
                            <Border CornerRadius="4" Padding="6,2" Margin="0,2,4,2"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="DetailDescriptionBox"
                         AutomationProperties.Name="Description"
                         PlaceholderText="Notes"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         Text="{x:Bind Shell.Detail.Description, Mode=TwoWay}"
                         LostFocus="OnDetailDescriptionCommitted" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Subtasks" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Shell.Detail.Subtasks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SubtaskSummary">
                                <TextBlock Text="{x:Bind Title}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="SubtaskBox" PlaceholderText="Add a subtask"
                             KeyDown="OnSubtaskKeyDown" />

                    <TextBlock Text="Comments" Style="{ThemeResource CaptionTextBlockStyle}"
                               Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{x:Bind Shell.Detail.Comments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CommentSummary">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" />
                                    <TextBlock Text="Not synced yet"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind IsPending, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
                <TextBox x:Name="CommentBox" PlaceholderText="Add a comment"
                         KeyDown="OnCommentKeyDown" />
                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Bind Shell.Detail.ErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind Shell.Detail.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Grid>
        </Grid>
</UserControl>
