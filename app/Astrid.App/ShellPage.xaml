<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Astrid.App.Views">

    <!--
        The window, as an arrangement of parts. Each part is a UserControl in Views/ with its own
        XAML and code-behind, bound to the same ShellViewModel this page hands it; what stays here
        is what needs more than one part — the keyboard, the theme, and the one detail pane that
        moves between the list column and a board card. The converters and the styles they all
        draw with are in Views/ShellResources.xaml, merged from App.xaml.
    -->

    <!--
        An opaque base under everything.

        The sidebar is a translucent layer, so whatever sits behind it is what it tints. Without a
        themed base here that was the window's own backdrop, which does not follow RequestedTheme —
        so dark mode drew a light grey sidebar beside a dark list. The Ocean wash is a child of
        this, above the base and below the chrome, which is what lets one surface serve all four
        looks.
    -->
    <Grid x:Name="RootGrid" KeyDown="OnKeyDown"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <!--
                The conversation, then the detail pane. Auto rather than fixed widths so each
                takes no space at all when it is shut, and the list gets the window back.
            -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            The Ocean surface: the brand look is a light appearance behind a cyan wash, so it is a
            layer under the chrome rather than a fourth set of brushes. Collapsed for every other
            theme, which is the whole difference between "ocean" and "light".

            Under everything and hit-test invisible: it is a surface, not a control, and a
            transparent rectangle that swallowed clicks would break the sidebar it sits behind.
        -->
        <Rectangle x:Name="OceanSurface"
                   Grid.ColumnSpan="3"
                   IsHitTestVisible="False"
                   Visibility="Collapsed">
            <Rectangle.Fill>
                <StaticResource ResourceKey="AstridOceanBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <!-- The first run, once. Over everything. -->
        <views:TourOverlay x:Name="Tour" Grid.ColumnSpan="4" Canvas.ZIndex="20" />

        <!--
            The command palette, over everything. It spans the columns rather than sitting in
            one: it is not part of the layout, it is a thing that appears over it.
        -->
        <views:CommandPaletteOverlay x:Name="Palette" Grid.ColumnSpan="4" Canvas.ZIndex="10" />

        <!--
            The sign-in screen. It covers the app rather than replacing it, so the window does
            not have to tear down and rebuild the whole tree on the way in and out.

            After the column definitions on purpose: in XAML a property element cannot follow
            a content child, and putting a child first made the XAML compiler fail with no
            message at all — an hour of bisecting to find one ordering rule.
        -->
        <views:SignInOverlay x:Name="SignIn" Grid.Column="0" Grid.ColumnSpan="3" Canvas.ZIndex="10" />

        <!-- The sidebar: favourites, then everything else. Collapsed while signed out. -->
        <views:SidebarView x:Name="Sidebar" Grid.Column="0" />

        <!-- The list itself. Collapsed while signed out, for the reason above. -->
        <!--
            The tasks sit on a sheet, not on the wash.

            Ocean is a cyan SURFACE with the work on a near-white page over it — that is how the
            Mac reads, and a gradient running behind the rows makes them look grey rather than
            brand-coloured. Opaque on purpose: a translucent layer here let the wash back
            through and undid the point of it.
        -->
        <Grid Grid.Column="1" Margin="0"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="4"
                       Width="1"
                       HorizontalAlignment="Left"
                       IsHitTestVisible="False"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <views:ListHeaderView x:Name="Header" Grid.Row="0" />

            <!--
                The board and the list are two views of one list's work, not two screens: they
                share the rows the quick-add and the list take, and the toggle swaps which is
                drawn. Nothing else moves.
            -->
            <views:BoardView x:Name="Board" Grid.Row="1" Grid.RowSpan="2" />
            <views:TaskRowsView x:Name="Rows" Grid.Row="1" Grid.RowSpan="2" />

            <TextBlock Grid.Row="3"
                       Margin="20,4,20,12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Text="{x:Bind Shell.Tasks.ErrorMessage, Mode=OneWay}"
                       Visibility="{x:Bind Shell.Tasks.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- The conversation. Beside the list, and collapsed rather than narrow when it is shut. -->
        <views:ChatPane x:Name="Chat" Grid.Column="2" />

        <!--
            The task detail. Collapsed rather than merely narrow when nothing is open, so it is out
            of the tab order as well as out of the way.

            Named, because it moves. On the board it is lifted out of this column and set inside
            the expanded card's slot (task 91a25b8a), then put back here when that card collapses
            or the list view returns. Its visibility is set by the same code, since where it is and
            whether it shows are one decision.
        -->
        <views:TaskDetailPane x:Name="Detail" Grid.Column="3" Visibility="Collapsed" />
    </Grid>
</UserControl>
