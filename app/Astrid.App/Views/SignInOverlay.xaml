<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.SignInOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The sign-in screen. It covers the app rather than replacing it, so the window does
        not have to tear down and rebuild the whole tree on the way in and out — and so
        signing out leaves an empty list behind it rather than a blank window.

        Its ground is set in `ApplyTheme` rather than here: it covers the Ocean surface, so
        it wears the wash itself, and the first screen anybody sees would otherwise be the
        one screen the brand colour never touches.

        It sits AFTER the column definitions on purpose: in XAML a property element cannot
        follow a content child, and putting this first made the XAML compiler fail with no
        message at all — an hour of bisecting to find one ordering rule.
    -->
    <Grid x:Name="SignInLayer"
          Background="Transparent"
          Visibility="{x:Bind Shell.SignIn.NeedsSignIn, Mode=OneWay, Converter={StaticResource Visible}}">
        <!--
            A card rather than text floating in the middle of a window. This is the first
            screen anybody sees and it was three centred paragraphs; giving it an edge, a
            mark and some air makes it look like a product rather than a dialog that lost
            its dialog.
        -->
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="420"
                Padding="40,36"
                CornerRadius="12"
                Background="{ThemeResource AstridSurface}"
                BorderThickness="1"
                BorderBrush="{ThemeResource AstridBorder}">
            <StackPanel Spacing="20">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <!-- The mark. The accent is the brand's, so it comes from the theme. -->
                    <!-- The same rounded square the sidebar wears, at twice the size. -->
                    <Border Width="52" Height="52" CornerRadius="12"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource AstridAccentBrush}">
                        <TextBlock Text="&#xE930;"
                                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                   FontSize="24"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Uid="astrid" Text="Astrid"
                               Style="{ThemeResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource AstridTextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Uid="your_tasks_on_this_machine_and" Text="Your tasks, on this machine and everywhere else."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource AstridTextSecondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>

                <Button x:Uid="sign_in_button" x:Name="SignInButton"
                        Content="Sign in with your browser"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,10"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnSignIn" />

                <TextBlock x:Uid="passkeys_google_and_magic_links_all" TextWrapping="Wrap" TextAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource AstridTextMuted}"
                           Text="Passkeys, Google and magic links all work there. You stay signed in here afterwards." />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            Visibility="{x:Bind Shell.SignIn.IsWaitingForBrowser, Mode=OneWay, Converter={StaticResource Visible}}">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Uid="waiting_for_your_browser" Text="Waiting for your browser…"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource AstridTextSecondary}" />
                    <HyperlinkButton x:Uid="cancel" Content="Cancel" Click="OnCancelSignIn" Padding="4,0" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Text="{x:Bind Shell.SignIn.ErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind Shell.SignIn.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
