<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.ChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The conversation, and the rail it leaves behind when it is hidden (task ab4cb9ee).

        Two children of one cell rather than one child that changes width: exactly one is ever
        visible, so the Auto column in ShellPage takes whichever it is, and neither state has to
        know the other's measurements. The rail is how astrid-web does it too — hiding a pane into
        nothing would put the way back on a different part of the screen from the way out.

        Both are gone while signed out: the sign-in screen covers this column, and a rail drawn
        under it would be a control for a window nobody is in yet.
    -->
    <Grid Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">

    <Grid Width="320"
          Background="{ThemeResource AstridSurface}"
          BorderThickness="1,0,0,0"
          BorderBrush="{ThemeResource AstridBorder}"
          Visibility="{x:Bind Shell.IsChatOpen, Mode=OneWay, Converter={StaticResource Visible}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The same header the task detail wears, so the two side panels are one thing. -->
        <Border Grid.Row="0"
                Padding="16,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource AstridBorder}">
            <!--
                The hide button at the pane's INNER top corner — its left — so it is the mirror
                image of the sidebar's, which sits at the sidebar's inner corner on the right.
                That symmetry is the whole request (task ab4cb9ee): one pair of controls that
                close the window's two side panels towards the work in the middle.
            -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="hide_messages"
                        AutomationProperties.Name="Hide messages"
                        ToolTipService.ToolTip="Hide messages"
                        Style="{StaticResource PaneToggleButton}"
                        Click="OnHideChat">
                    <FontIcon FontSize="14" Glyph="&#xE89F;" />
                </Button>
                <TextBlock x:Uid="chat" Text="Chat"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AstridTextPrimary}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <!--
                    A list with nowhere to talk. Saying so beats an empty panel with a box that
                    will not take anything typed into it.
                -->
                <TextBlock x:Uid="this_list_has_no_conversation_yet" Text="This list has no conversation yet."
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,24,0,0"
                           Foreground="{ThemeResource AstridTextMuted}"
                           Visibility="{x:Bind Shell.Chat.HasChannel, Mode=OneWay, Converter={StaticResource NotVisible}}" />

                <!--
                    Bubbles, sided by who wrote each one, exactly as the task thread draws them
                    — the core already says whose a message is, and the panel was drawing a flat
                    list of lines that never used it.
                -->
                <ItemsControl ItemsSource="{x:Bind Shell.Chat.Messages, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bindings:MessageRow">
                            <StackPanel Margin="0,4"
                                        HorizontalAlignment="{x:Bind IsMine, Converter={StaticResource BubbleAlign}}">
                                <!-- "Dana joined the list" is nobody's voice, so it takes no side. -->
                                <TextBlock Text="{x:Bind Content}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{ThemeResource AstridTextMuted}"
                                           Visibility="{x:Bind IsSystem, Converter={StaticResource Visible}}" />

                                <Border CornerRadius="10"
                                        Padding="12"
                                        MaxWidth="240"
                                        Background="{x:Bind IsMine, Converter={StaticResource BubbleBrush}}"
                                        Visibility="{x:Bind IsSystem, Converter={StaticResource NotVisible}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Converter={StaticResource Byline}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AstridTextMuted}" />
                                        <!--
                                            Drawn through the same markdown a comment and a
                                            description get (task 5f3453e2), so a mention is a
                                            pill, a link is a link and a task id is a link to that
                                            task. This was a TextBlock of the raw text, which is
                                            why `**bold**` arrived with its asterisks and an id
                                            could only be retyped. The system line above stays
                                            plain: nobody writes it.
                                        -->
                                        <local:MarkdownView Blocks="{x:Bind Blocks}"
                                                            Foreground="{ThemeResource AstridTextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The same bar as the task thread's, minus the paperclip: a list chat takes no files. -->
        <Border Grid.Row="2"
                Padding="12"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource AstridBorder}">
            <StackPanel Spacing="8">
                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Bind Shell.Chat.ErrorMessage, Mode=OneWay}"
                           Visibility="{x:Bind Shell.Chat.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="chat_box" Grid.Column="0"
                             x:Name="ChatBox"
                             PlaceholderText="Say something"
                             AutomationProperties.Name="Message"
                             Background="{ThemeResource AstridSurfaceHover}"
                             BorderThickness="0"
                             CornerRadius="12"
                             Padding="12,7"
                             IsEnabled="{x:Bind Shell.Chat.HasChannel, Mode=OneWay}"
                             KeyDown="OnChatKeyDown" />
                    <!--
                        Return sent a message and nothing else did, so the affordance for the
                        only action in the panel was a keystroke you had to already know about.
                    -->
                    <Button x:Uid="send" Grid.Column="1"
                            AutomationProperties.Name="Send"
                            Style="{StaticResource CommentBarButton}"
                            Background="{ThemeResource AstridAccentBrush}"
                            IsEnabled="{x:Bind Shell.Chat.HasChannel, Mode=OneWay}"
                            Click="OnSendChat">
                        <FontIcon FontSize="14" Glyph="&#xE724;" Foreground="White" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <!--
        Hidden: a 48px rail holding only the way back, the same width astrid-web's is.
    -->
    <Border Width="48"
            Background="{ThemeResource AstridSurface}"
            BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource AstridBorder}"
            Visibility="{x:Bind Shell.IsChatOpen, Mode=OneWay, Converter={StaticResource NotVisible}}">
        <Button x:Uid="show_messages"
                VerticalAlignment="Top"
                Margin="0,14,0,0"
                AutomationProperties.Name="Show messages"
                ToolTipService.ToolTip="Show messages"
                Style="{StaticResource PaneToggleButton}"
                Click="OnShowChat">
            <FontIcon FontSize="14" Glyph="&#xE8A0;" />
        </Button>
    </Border>

    </Grid>
</UserControl>
