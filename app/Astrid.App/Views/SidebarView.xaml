<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="SidebarRowTemplate" x:DataType="bindings:ListSummary">
            <!--
                A row takes a dropped task (task 27cae198). The background is what makes the whole
                row a target rather than only its text; which rows accept, and what a drop writes,
                is answered in the code-behind and the view model.
            -->
            <Grid ColumnSpacing="8"
                  Background="Transparent"
                  AllowDrop="True"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                        VerticalAlignment="Center"
                        Background="{x:Bind DisplayColor, Converter={StaticResource PriorityBrush}}" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource AstridTextSecondary}" />
                <!-- How many are behind it. The web puts this on every row and it is the one
                     number that makes a sidebar worth reading. -->
                <Border Grid.Column="2"
                        CornerRadius="4"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AstridSurfaceHover}"
                        Visibility="{x:Bind TaskCount, Converter={StaticResource CountVisible}}">
                    <TextBlock Text="{x:Bind TaskCount}"
                               FontSize="11"
                               Foreground="{ThemeResource AstridTextPrimary}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        The sidebar: favourites, then everything else.

        Collapsed while signed out rather than merely covered. An overlay hides it from the
        eye and leaves it in the tab order and in the accessibility tree, so a keyboard or
        screen-reader user can reach the previous session's lists from behind the sign-in
        screen.
    -->
    <!--
        The sidebar, and the rail it leaves behind when it is hidden (task ab4cb9ee). Exactly one
        of the two is ever visible, so the column in ShellPage takes whichever it is — see the
        matching pair in ChatPane.xaml, which this is the mirror image of.
    -->
    <Grid Visibility="{x:Bind Shell.SignIn.IsSignedIn, Mode=OneWay, Converter={StaticResource Visible}}">

    <Grid Width="260"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          Visibility="{x:Bind Shell.IsSidebarOpen, Mode=OneWay, Converter={StaticResource Visible}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The mark and the wordmark used to be here, as the web's sidebar header has them. They
            are the title bar now (TitleBarView), which sits directly above this column and wears
            the same layer, so the top left reads as one surface with the brand at its corner.

            What is here instead is the bell and the hide button, at this column's INNER corner —
            its right — the latter being what makes it and the messages pane's one pair of
            controls rather than two.

            This row is web's sidebar header right-hand cluster: bell, search, toggle
            (LeftSidebar.tsx). Search is the title bar's, because the brand header is
            (TitleBarView — task 20dcc235), so what lands here is the bell and the toggle, in
            web's order.
        -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="4"
                    Margin="0,8,12,0">
            <!--
                The bell: what happened to work you are involved in - assigned, mentioned,
                replied to, commented on, status changed, completed - as the web's
                notification-bell.tsx. The badge is from the cache the moment the window
                opens; opening the flyout asks the server.

                It was at the far right of the list header until task 96759883, the opposite
                end of the window from where web and the Mac keep it, and the last thing left
                in that cluster once the account row had gone (task ffcc6abf). It wears the
                hide button's style so the two read as one row, and the badge's overhang is
                small enough to stay inside the button rather than reach across the gap.

                It goes into the rail with the sidebar, and that is web's behaviour too:
                LeftSidebar's collapsed rail renders only the toggle.
            -->
            <Button x:Uid="notifications_button" x:Name="NotificationsButton"
                    Style="{StaticResource PaneToggleButton}"
                    AutomationProperties.Name="Notifications"
                    ToolTipService.ToolTip="Notifications">
                <Grid>
                    <TextBlock Text="&#xEA8F;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                               FontSize="14" />
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-6,0"
                            Visibility="{x:Bind Shell.Notifications.HasUnread, Mode=OneWay, Converter={StaticResource Visible}}">
                        <TextBlock Text="{x:Bind Shell.Notifications.UnreadText, Mode=OneWay}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <!--
                        Opens rightwards from the window's left edge now, which is what web's
                        align="start" says about the same bell.
                    -->
                    <Flyout x:Name="NotificationsFlyout" Opening="OnNotificationsOpening" Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="8" Width="360">
                            <Grid>
                                <TextBlock x:Uid="notifications_heading" Text="Notifications"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Button x:Uid="mark_all_read" Content="Mark all read"
                                        AutomationProperties.Name="Mark all read"
                                        HorizontalAlignment="Right"
                                        Click="OnMarkAllNotificationsRead"
                                        IsEnabled="{x:Bind Shell.Notifications.HasUnread, Mode=OneWay}" />
                            </Grid>
                            <TextBlock x:Uid="nothing_new" Text="Nothing new."
                                       Foreground="{ThemeResource AstridTextMuted}"
                                       Visibility="{x:Bind Shell.Notifications.IsEmpty, Mode=OneWay, Converter={StaticResource Visible}}" />
                            <ListView ItemsSource="{x:Bind Shell.Notifications.Items, Mode=OneWay}"
                                      IsItemClickEnabled="True"
                                      SelectionMode="None"
                                      ItemClick="OnNotificationOpened"
                                      MaxHeight="420">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:NotificationItem">
                                        <StackPanel Spacing="2" Margin="0,6"
                                                    Opacity="{x:Bind IsRead, Converter={StaticResource CompletedOpacity}}">
                                            <TextBlock Text="{x:Bind LabelKey, Converter={StaticResource PickTitle}}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AstridTextSecondary}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind TaskIdentifier}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource AstridTextMuted}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind TaskText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AstridTextPrimary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Uid="hide_sidebar"
                    AutomationProperties.Name="Hide sidebar"
                    ToolTipService.ToolTip="Hide sidebar"
                    Style="{StaticResource PaneToggleButton}"
                    Click="OnHideSidebar">
                <FontIcon FontSize="14" Glyph="&#xE8A0;" />
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="12,8,12,8" Spacing="4">
                <!--
                    Selection is no longer stated here (astrid-core DS5, task 787c7aa5).

                    Six brushes used to be: a blue tint at 15% behind blue text, 22% on hover
                    and pressed, with Windows' accent bar and heavy focus box turned off. They
                    were overrides of the brushes WinUI's own ListViewItemPresenter reaches
                    for, which is the only thing that presenter offers — a selected fill, never
                    a selected outline. DS5 took the Mac's outline for every client, so
                    `SidebarRowStyle` draws the row itself and owns all six states, and nothing
                    is left here to override it from above.
                -->
                <!--
                    Every entry in here is the same row: a mark, a name, and the number of
                    tasks behind it. astrid-web draws them from one component and so does
                    this — three collections, one template, because three copies of a row
                    is how they drift.

                    My Tasks first. It is the view the app opens on rather than one of the
                    lists, which is why it is its own collection.
                -->
                <ListView x:Name="MyTasksList"
                          ItemsSource="{x:Bind Shell.Sidebar.MyTasks, Mode=OneWay}"
                          SelectionChanged="OnListSelected"
                          ItemContainerStyle="{StaticResource SidebarRowStyle}"
                          ItemTemplate="{StaticResource SidebarRowTemplate}"
                          SelectionMode="Single" />

                <TextBlock x:Uid="favourites" Text="Favourites"
                           Margin="8,12,8,2"
                           FontSize="11"
                           FontWeight="Medium"
                           Opacity="0.5"
                           Foreground="{ThemeResource AstridTextPrimary}"
                           Visibility="{x:Bind Shell.Sidebar.Favorites.Count, Mode=OneWay, Converter={StaticResource Visible}}" />
                <ListView x:Name="FavoritesList"
                          ItemsSource="{x:Bind Shell.Sidebar.Favorites, Mode=OneWay}"
                          SelectionChanged="OnListSelected"
                          ItemContainerStyle="{StaticResource SidebarRowStyle}"
                          ItemTemplate="{StaticResource SidebarRowTemplate}"
                          SelectionMode="Single" />

                <TextBlock x:Uid="lists" Text="Lists"
                           Margin="8,12,8,2"
                           FontSize="11"
                           FontWeight="Medium"
                           Opacity="0.5"
                           Foreground="{ThemeResource AstridTextPrimary}" />
                <ListView x:Name="ListsList"
                          ItemsSource="{x:Bind Shell.Sidebar.Lists, Mode=OneWay}"
                          SelectionChanged="OnListSelected"
                          ItemContainerStyle="{StaticResource SidebarRowStyle}"
                          ItemTemplate="{StaticResource SidebarRowTemplate}"
                          SelectionMode="Single" />
            </StackPanel>
        </ScrollViewer>

        <!-- The same shape as quick add, because it is the same gesture one column over. -->
        <Grid Grid.Row="2" Margin="12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
                The public lists anybody may browse and copy (task f6bc59e8), behind a globe as
                the web keeps them in its sidebar. The catalogue is the server's and is fetched
                as the flyout opens; copying one puts it in this account and opens it.
            -->
            <Button x:Uid="public_lists_button" Grid.Column="2"
                    Width="32" Height="32"
                    Padding="0"
                    CornerRadius="8"
                    AutomationProperties.Name="Public lists"
                    ToolTipService.ToolTip="Browse public lists">
                <FontIcon FontSize="14" Glyph="&#xE774;" />
                <Button.Flyout>
                    <Flyout x:Name="PublicListsFlyout" Opening="OnPublicListsOpening" Placement="Right">
                        <StackPanel Spacing="8" Width="360">
                            <TextBlock x:Uid="public_lists_heading" Text="Public lists"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ProgressRing Width="20" Height="20" HorizontalAlignment="Left"
                                          IsActive="{x:Bind Shell.PublicLists.IsLoading, Mode=OneWay}"
                                          Visibility="{x:Bind Shell.PublicLists.IsLoading, Mode=OneWay, Converter={StaticResource Visible}}" />
                            <TextBlock x:Uid="no_public_lists" Text="Nothing to browse yet."
                                       Foreground="{ThemeResource AstridTextMuted}"
                                       Visibility="{x:Bind Shell.PublicLists.IsEmpty, Mode=OneWay, Converter={StaticResource Visible}}" />
                            <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind Shell.PublicLists.ErrorMessage, Mode=OneWay}"
                                       Visibility="{x:Bind Shell.PublicLists.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                            <ListView ItemsSource="{x:Bind Shell.PublicLists.Lists, Mode=OneWay}"
                                      SelectionMode="None"
                                      MaxHeight="420">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:PublicListSummary">
                                        <Grid ColumnSpacing="8" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AstridTextPrimary}" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AstridTextMuted}"
                                                           Visibility="{x:Bind Description, Converter={StaticResource Visible}}" />
                                                <!-- Whose, and how much is in it: the numbers wear
                                                     glyphs rather than words, so nothing here needs
                                                     translating. -->
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind OwnerName}" FontSize="11"
                                                               Foreground="{ThemeResource AstridTextMuted}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <FontIcon Glyph="&#xE73A;" FontSize="10"
                                                                  Foreground="{ThemeResource AstridTextMuted}" />
                                                        <TextBlock Text="{x:Bind TaskCount}" FontSize="11"
                                                                   Foreground="{ThemeResource AstridTextMuted}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <FontIcon Glyph="&#xE716;" FontSize="10"
                                                                  Foreground="{ThemeResource AstridTextMuted}" />
                                                        <TextBlock Text="{x:Bind MemberCount}" FontSize="11"
                                                                   Foreground="{ThemeResource AstridTextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Uid="copy" Grid.Column="1" Content="Copy"
                                                    VerticalAlignment="Center"
                                                    Tag="{x:Bind Id}"
                                                    AutomationProperties.Name="{x:Bind CopyActionName}"
                                                    Click="OnCopyPublicList" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBox x:Uid="new_list_box" x:Name="NewListBox"
                     Grid.Column="0"
                     PlaceholderText="New list"
                     Background="{ThemeResource AstridSurface}"
                     BorderThickness="1"
                     BorderBrush="{ThemeResource AstridBorder}"
                     CornerRadius="8"
                     Padding="10,6"
                     KeyDown="OnNewListKeyDown" />
            <!-- The other "Add" — see AddTaskButton in TaskRowsView.xaml (task e785bbf3). -->
            <Button x:Uid="new_list" Grid.Column="1"
                    AutomationProperties.AutomationId="AddListButton"
                    Width="32" Height="32"
                    Padding="0"
                    CornerRadius="8"
                    AutomationProperties.Name="Add"
                    ToolTipService.ToolTip="New list"
                    Click="OnAddList">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </Button>
        </Grid>

        <!--
            The account, at the foot of the sidebar (task ffcc6abf — AWTD-1179, where Jon chose
            the web-desktop pattern). astrid-web's LeftSidebar ends in exactly this row: the
            signed-in user's photo, their name, and a gear, and the whole row opens Settings.
            There is no menu in between on web, and there is none here.

            It was a bare person glyph in the list header before — the far end of the window from
            where web keeps it, and it never said whose account it was. The name comes from the
            account the shell reads at startup (ShellViewModel.StartAsync), so it is there before
            the screen behind this row has ever been opened.
        -->
        <Border Grid.Row="3"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource AstridBorder}">
            <Button x:Uid="account_and_settings"
                    AutomationProperties.AutomationId="AccountButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    AutomationProperties.Name="Account"
                    ToolTipService.ToolTip="Account and settings"
                    Click="OnOpenSettings">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AstridBorder}">
                        <Image x:Uid="profile_photo"
                               Source="{x:Bind Shell.Settings.Account.PhotoUrl, Mode=OneWay, Converter={StaticResource RemoteImage}}"
                               Stretch="UniformToFill"
                               AutomationProperties.Name="Profile photo" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Shell.Settings.Account.DisplayName, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource AstridTextSecondary}" />
                    <FontIcon Grid.Column="2" FontSize="14" Glyph="&#xE713;"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AstridTextMuted}" />
                </Grid>
            </Button>
        </Border>
    </Grid>

    <!-- Hidden: a 48px rail holding only the way back, the width astrid-web's rail is. -->
    <Border Width="48"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{x:Bind Shell.IsSidebarOpen, Mode=OneWay, Converter={StaticResource NotVisible}}">
        <Button x:Uid="show_sidebar"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                AutomationProperties.Name="Show sidebar"
                ToolTipService.ToolTip="Show sidebar"
                Style="{StaticResource PaneToggleButton}"
                Click="OnShowSidebar">
            <FontIcon FontSize="14" Glyph="&#xE89F;" />
        </Button>
    </Border>

    </Grid>
</UserControl>
