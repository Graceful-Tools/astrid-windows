<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Astrid.App.Views.ShellResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        What every part of the window shares: the converters, the styles, and the one
        DataTemplate that carries no event handler.

        Merged into the application's resources rather than declared on the page, because the
        window is now several UserControls and a StaticResource in one of them cannot see
        another's resources. x:Bind resolves a converter key against its own root's resources
        and then the application's, so the converters are found from every control; the
        templates that name a Click or a Drop handler stay with the control whose code-behind
        answers it.
    -->
    <local:PriorityBrushConverter x:Key="PriorityBrush" />
    <local:DepthIndentConverter x:Key="DepthIndent" />
    <local:BoolToVisibilityConverter x:Key="Visible" />
    <local:DueLabelConverter x:Key="DueText" />
    <local:PickTitleConverter x:Key="PickTitle" />
    <local:AssigneeNameConverter x:Key="AssigneeText" />
    <local:RepeatSummaryConverter x:Key="RepeatText" />
    <local:ReminderStateConverter x:Key="ReminderText" />
    <local:NotVisibleConverter x:Key="NotVisible" />
    <local:StrikethroughConverter x:Key="Strikethrough" />
    <local:WordsConverter x:Key="Words" />
    <local:PasskeyAddedConverter x:Key="PasskeyAdded" />
    <local:FixedWordsConverter x:Key="PasskeyRenameWord" Key="passkeys.rename" />
    <local:FixedWordsConverter x:Key="PasskeyRevokeWord" Key="passkeys.revoke" />
    <!-- A Done card's pill, and what a screen reader hears for it instead of the check. -->
    <local:FilledWordsConverter x:Key="CompletedPillWords" Key="board.card.completed_pill" />
    <local:FilledWordsConverter x:Key="CompletedPillName" Key="board.card.completed_on" />
    <local:FilterStateConverter x:Key="FilterText" />
    <local:MessageBylineConverter x:Key="Byline" />
    <local:TimerButtonConverter x:Key="TimerText" />
    <local:StatConverter x:Key="StatFinished" Key="stats.completed" />
    <local:StatConverter x:Key="StatInspired" Key="stats.inspired" />
    <local:StatConverter x:Key="StatSupported" Key="stats.supported" />
    <local:LoggedTimeConverter x:Key="LoggedTime" />
    <!-- The Outbox's refused writes, and what a retry did with them (task 84e077ca). -->
    <!--
        "Comments (3)", and "Comments (0)" rather than nothing at zero — the Mac's toolbar says
        its count even on an empty thread (task 77d17dc8). The zero key is a separate string
        because a language that writes the count differently when there are none should be able
        to; it is not "{0}" with a 0 in it by accident.
    -->
    <local:CountedWordsConverter x:Key="CommentsHeading" Key="comments.heading"
                                 ZeroKey="comments.heading_none" />
    <local:CountedWordsConverter x:Key="RefusedWrites" Key="outbox.refused" />
    <local:CountedWordsConverter x:Key="RetryOutcome" Key="outbox.retry_sent"
                                 ZeroKey="outbox.retry_none" />
    <local:CredentialStateConverter x:Key="CredentialState" />
    <local:PrefixedWordsConverter x:Key="ConnectionOwner" Prefix="connections.owner" />
    <local:PrefixedWordsConverter x:Key="ConnectionStatus" Prefix="connections.status" />
    <local:ActsAsConverter x:Key="ActsAs" />
    <local:IsoDayConverter x:Key="IsoDay" />
    <local:ReviewLineConverter x:Key="ReviewLine" />
    <local:RowOpacityConverter x:Key="RowOpacity" />
    <local:FileGlyphConverter x:Key="FileGlyph" />
    <local:ChipTintConverter x:Key="ChipTint" />
    <local:ChipColourConverter x:Key="ChipColour" />
    <local:FileThumbnailConverter x:Key="FileThumbnail" />
    <local:RemoteImageConverter x:Key="RemoteImage" />
    <local:ChipGlyphConverter x:Key="ChipGlyph" />
    <local:LeadingMarkConverter x:Key="LeadingMark" />
    <local:BubbleAlignConverter x:Key="BubbleAlign" />
    <local:BubbleBrushConverter x:Key="BubbleBrush" />
    <!--
        What a list has been doing (task 48c624ad). The view model carries numbers and keys, so
        the words are here; the plot's size is stated once, on the one converter both series go
        through, so the two lines cannot land on different scales.
    -->
    <local:DashedTextConverter x:Key="Dashed" />
    <local:InsightWindowConverter x:Key="InsightWindow" />
    <local:InsightDurationConverter x:Key="InsightMedian" />
    <local:InsightSampleConverter x:Key="InsightSample" />
    <local:InsightCountConverter x:Key="InsightNewTotal" Key="listInsights.createdTotal" />
    <local:InsightCountConverter x:Key="InsightDoneTotal" Key="listInsights.completedTotal" />
    <local:InsightCountsConverter x:Key="InsightProfileCounts" Key="listInsights.profileCounts" />
    <local:InsightCountsConverter x:Key="InsightActivityCounts" Key="listInsights.activityCounts" />
    <local:InsightLineConverter x:Key="InsightLine" PlotWidth="288" PlotHeight="120" />

    <!--
        One sidebar row, shared by My Tasks, the favourites and the lists.

        astrid-web's `ListItem`: a round mark, the name, and a count badge on the right. Its
        selection is a blue tint with blue text rather than Windows' accent bar, and the
        container carries it — a row that painted its own selection would sit inside WinUI's.
    -->
    <!--
        One field row in the task detail, as astrid-web draws them: no button chrome, a 32px
        icon column, and the value where the title is. The icon replaces the word — it keeps
        every row's content starting at the same x, which is what the label was really for, in
        32px rather than 80.
    -->
    <!--
        One of the four priority squares. astrid-web draws them at 40px with the chosen one
        filled and the rest outlined in the same colour; the colours themselves are set in
        code-behind against the current value, because "which of the four is on" is one fact
        and four bindings that each re-derive it is four places to get it wrong.
    -->
    <Style x:Key="PriorityChoice" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A section heading inside the detail pane: small, quiet, and above its content. -->
    <Style x:Key="DetailSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
        <Setter Property="Margin" Value="0,14,0,4" />
    </Style>

    <!-- The round buttons either side of the comment box, as the web's input bar wears them. -->
    <Style x:Key="CommentBarButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        The pair that closes the window's two side panels towards the work (task ab4cb9ee): the
        sidebar's on the left, the messages pane's mirroring it on the right. One style, because
        a mirror image that had drifted into a slightly different button would read as two
        unrelated controls — which is the thing this task is fixing.
    -->
    <Style x:Key="PaneToggleButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DetailField" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!--
        The task detail's alignment invariant, as two numbers rather than as prose (task
        439e94a4).

        The icon column is exactly as wide as the title row's leading control, and shares the
        title row's gap inside the same container padding — so each field icon lands centred
        under the checkbox and each value's left edge lands on the title's. The sum is
        16 + 32 + 8 = 56px, where the 16 is the padding on the pane's header Border and on its
        body ScrollViewer. Web states the same invariant in the same terms in
        `components/task-detail/TaskFieldRow.tsx`; iOS and Mac state it with their own, 16 + 34
        + 12 = 62pt.

        Stated here because the pane used to retype `ColumnSpacing="8"` over
        `<ColumnDefinition Width="32" />` for all eleven rows, with the sum written down only in
        a comment. Each of the other two platforms had to fix that same drift, and both now
        name the terms and pin them — `TaskDetailAlignmentTests` is this one's pin, and it
        covers the container padding too, since changing one term without the other is what
        breaks the columns.
    -->
    <x:Double x:Key="DetailFieldIconColumn">32</x:Double>
    <x:Double x:Key="DetailFieldGap">8</x:Double>

    <!--
        The corner-radius scale (task 77d17dc8), in the Mac's values:
        `radiusSmall/Medium/Large/XLarge` = 6/8/12/16.

        Taken from the Mac deliberately, and it is the ONE axis where that is the right
        reference. The `Astrid*` brushes above are web's, named after
        `astrid-web/styles/themes/*.css` so a value can be checked against that file — and on
        colour it is the Mac that drifted, so moving those toward it would be a regression.
        Radius is different: Windows had no scale at all, so there was nothing to diverge from,
        and web's own base radius token is 8px, the middle step here either way.

        Stated here for the same reason as the two numbers above: the detail pane alone had
        hard-coded 4, 6, 8, 10 and 12 across fourteen elements, which is how the alignment sum
        came to be retyped eleven times before anyone wrote it down. `DesignRadiusScaleTests`
        is this one's pin, and it asserts both halves — that the scale exists, and that the
        pane references it rather than restating a number.
    -->
    <CornerRadius x:Key="AstridRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="AstridRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="AstridRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="AstridRadiusXLarge">16</CornerRadius>

    <!--
        How wide a selection outline is (astrid-core DS5, task 787c7aa5).

        A density lookup, not a constant: the tokens carry `size.compact.selection-outline` at 1.5
        and `size.comfortable.selection-outline` at 2.5, and the register reads DS5 as "1.5 wide on
        pointer layouts and 2.5 on touch". This shell is a pointer layout and has no density setting
        of its own, so it takes the compact one — stated rather than assumed, so that the day a
        comfortable mode arrives this is the line that changes. `DesignTokenTests` names which of the
        two it is.
    -->
    <Thickness x:Key="AstridSelectionOutlineThickness">1.5</Thickness>

    <!--
        Completing a task pops its mark (astrid-core DS16, task 787c7aa5).

        `state.complete-pop-scale`, on `motion.spring` — which is a named entry with its own damping
        ratio and period rather than a duration and a curve, so it is read rather than approximated.
        Composition's SpringVector3NaturalMotionAnimation takes exactly those two, which is why
        `PriorityMark` can run the token's spring and not a stand-in for it.

        Here rather than in the control because that keeps all four of DS5's and DS16's numbers in
        the two files the design-metrics budget exempts, where one test compares them with the
        vendored tokens.
    -->
    <x:Double x:Key="AstridCompletePopScale">1.28</x:Double>
    <x:Double x:Key="AstridSpringDamping">0.85</x:Double>
    <x:Double x:Key="AstridSpringMs">280</x:Double>

    <Style x:Key="SidebarRowStyle" TargetType="ListViewItem">
        <!--
            Keyboard focus stays visible — it has to — but as a hairline in the accent rather
            than the two-tone black rectangle WinUI draws over the row it indicates.
        -->
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AstridBorderFocus}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="FocusVisualPrimaryThickness" Value="1" />
        <Setter Property="FocusVisualMargin" Value="-1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
        <!--
            The row draws its own states, which is the only way to get DS5's outline.

            WinUI's ListViewItem renders through a ListViewItemPresenter, and that presenter offers
            a selected BACKGROUND (`ListViewItemBackgroundSelected` and the pointer-over and pressed
            variants) and no selected BORDER. So there is no theme-resource route to an outline, and
            overriding those three brushes is exactly what the sidebar did instead: a 15% fill with
            22% hover and pressed states, which is the thing DS5 replaced.

            A Border and a ContentPresenter is the whole template. `Control.IsTemplateFocusTarget`
            keeps the four focus-visual setters above working, and the states below are the names
            SelectorItem goes to, so hover and pressed still read as they did — only selection
            changes.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Row"
                            Control.IsTemplateFocusTarget="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource AstridSelectionOutlineThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Row.Background" Value="{ThemeResource AstridSurfaceHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Row.Background" Value="{ThemeResource AstridSurfaceHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Row.BorderBrush" Value="{ThemeResource AstridSelectionOutline}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Row.Background" Value="{ThemeResource AstridSurfaceHover}" />
                                        <Setter Target="Row.BorderBrush" Value="{ThemeResource AstridSelectionOutline}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Row.Background" Value="{ThemeResource AstridSurfaceHover}" />
                                        <Setter Target="Row.BorderBrush" Value="{ThemeResource AstridSelectionOutline}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <local:CompletedOpacityConverter x:Key="CompletedOpacity" />
    <local:CompletedStrikeConverter x:Key="CompletedStrike" />
    <local:CountVisibleConverter x:Key="CountVisible" />
    <local:FilterTintConverter x:Key="FilterTint" />
    <local:SwatchRingConverter x:Key="SwatchRing" />
    <local:ChoiceLabelConverter x:Key="ChoiceLabel" />
    <local:ReplyIndentConverter x:Key="ReplyIndent" />

    <!-- The small quiet words under a bubble: Reply, Edit, Delete. -->
    <Style x:Key="BubbleAction" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
    </Style>
    <!-- One row of a defaults combo: the choice, named. -->
    <DataTemplate x:Key="DefaultChoiceTemplate" x:DataType="viewmodels:DefaultChoice">
        <TextBlock Text="{x:Bind Converter={StaticResource ChoiceLabel}}" />
    </DataTemplate>

    <!--
        The project board's swimlane chrome (task f8b844dd).

        Written HERE rather than on the view, because this file and App.xaml are where a size, a
        radius and a colour are supposed to be written down (task d7e381a7): a swimlane board is a
        dozen cells of repeating chrome, and spelling each one out in the view would be thirty-odd
        hand-typed numbers for the next change to retype. The radii come off the scale
        (task 77d17dc8) rather than being chosen per element.
    -->
    <Style x:Key="SwimlaneCardStyle" TargetType="views:BoardCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusMedium}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AstridBorder}" />
        <Setter Property="Background" Value="{ThemeResource AstridSurface}" />
    </Style>
    <!-- A two-column grid with the gap the mark and the words want, on a card and on a row head. -->
    <Style x:Key="SwimlaneGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <!-- Somebody else's mark on a swimlane card: the square, and the initials in it. -->
    <Style x:Key="SwimlaneMarkSquareStyle" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusSmall}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="SwimlaneMarkTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--
        The finished-on pill under a Done card's title (Jon, 2026-11-19; the same pill on every
        platform): a small capsule, secondary ink on the hover surface, which is a step off the
        card's own. The radius is the largest on the scale, which WinUI clamps to half the height —
        a capsule whatever the text size.
    -->
    <Style x:Key="DonePillStyle" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusXLarge}" />
        <Setter Property="Background" Value="{ThemeResource AstridSurfaceHover}" />
    </Style>
    <!--
        The same pill on a swimlane card, where the title sits in a plain StackPanel with no
        spacing of its own: the gap the single-list card's StackPanel gives, moved onto the pill.
    -->
    <Style x:Key="SwimlaneDonePillStyle" TargetType="Border" BasedOn="{StaticResource DonePillStyle}">
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="DonePillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextSecondary}" />
    </Style>
    <Style x:Key="SwimlaneCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="3" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextPrimary}" />
    </Style>
    <!--
        One cell: a row's cards in one of the project's columns. Its width is the column's width,
        and the header strip above uses the same one, which is what keeps the two in line.
    -->
    <Style x:Key="SwimlaneCellStyle" TargetType="Border">
        <Setter Property="Width" Value="264" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusSmall}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AstridBorder}" />
        <Setter Property="Background" Value="{ThemeResource AstridSurfaceHover}" />
    </Style>
    <Style x:Key="SwimlaneColumnHeadStyle" TargetType="Border">
        <Setter Property="Width" Value="264" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="SwimlaneColumnNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextSecondary}" />
    </Style>
    <!-- A strip of cells, or of column names: one gap, shared so the two stay in line. -->
    <Style x:Key="SwimlaneStripStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="SwimlaneRowStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <!-- The list's colour on its row head, as the sidebar draws it: 12px, which the radius rounds. -->
    <!--
        A row head sits at the LEFT, beside its name — it does NOT stretch across the strip.
        It used to: the board scrolls horizontally, so its content is measured against infinity
        and a star column grew to the width of every column together, which put the cross that
        removes the row a thousand pixels off the right of the window. UIA still reported the
        button, so every assertion passed; its BoundingRectangle was Empty, which is what
        offscreen looks like, and the only way to remove a row with a mouse was invisible.
    -->
    <Style x:Key="SwimlaneRowHeadStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="SwimlaneRowDotStyle" TargetType="Border">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SwimlaneRowNameStyle" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextPrimary}" />
    </Style>
    <Style x:Key="SwimlaneRowRemoveStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- The board's own chrome: its toolbar, its surface, and the line a failure is drawn on. -->
    <Style x:Key="BoardToolbarStyle" TargetType="Grid">
        <Setter Property="Margin" Value="12,4,12,8" />
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>
    <Style x:Key="BoardHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
    </Style>
    <Style x:Key="BoardSurfaceStyle" TargetType="ScrollViewer">
        <Setter Property="Margin" Value="12,0,12,8" />
    </Style>
    <Style x:Key="BoardStackStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <!--
        The two empty boards, which are not the same board: nothing saved means the project's own
        lists, and an empty saved set is a board cleared on purpose. Same chrome, different words.
    -->
    <Style x:Key="BoardNoticeStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,24,0,0" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BoardNoticeTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextSecondary}" />
    </Style>
    <Style x:Key="BoardNoticeBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
    </Style>
    <Style x:Key="BoardErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="20,4,20,12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!--
        The sidebar's Projects section (task f8b844dd; core AWTD-1681).

        Sizes here rather than on the view, for the reason the swimlane styles above give. The
        three headings already in SidebarView.xaml are left as they are: this section's heading
        uses the style, and changing the others would lower a budget the ratchet also checks.
    -->
    <Style x:Key="SidebarSectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,12,8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextPrimary}" />
    </Style>
    <Style x:Key="SidebarProjectRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="6" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- The chevron, which only turns: tapping the project's NAME opens its board. -->
    <Style x:Key="SidebarProjectChevronStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 16px across with an 8px radius, which is a circle. The colour is the core's. -->
    <Style x:Key="SidebarProjectDotStyle" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusMedium}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SidebarProjectNameStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextPrimary}" />
    </Style>
    <!-- A project's lists, indented under it. -->
    <Style x:Key="SidebarProjectListsStyle" TargetType="ItemsControl">
        <Setter Property="Margin" Value="30,0,0,4" />
    </Style>
    <Style x:Key="SidebarProjectListStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!--
        A list under its project gets the same colour dot every other sidebar row has: without
        one the rows read as loose text rather than as lists, and their names sat LEFT of the
        project name above them. 12px across with a 6px radius, which is a circle.
    -->
    <Style x:Key="SidebarProjectListDotStyle" TargetType="Border">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource AstridRadiusSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SidebarProjectListGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="6" />
    </Style>
    <Style x:Key="SidebarProjectListNameStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextSecondary}" />
    </Style>
</ResourceDictionary>
