<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Astrid.App.Views.ShellResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        What every part of the window shares: the converters, the styles, and the one
        DataTemplate that carries no event handler.

        Merged into the application's resources rather than declared on the page, because the
        window is now several UserControls and a StaticResource in one of them cannot see
        another's resources. x:Bind resolves a converter key against its own root's resources
        and then the application's, so the converters are found from every control; the
        templates that name a Click or a Drop handler stay with the control whose code-behind
        answers it.
    -->
    <local:PriorityBrushConverter x:Key="PriorityBrush" />
    <local:DepthIndentConverter x:Key="DepthIndent" />
    <local:BoolToVisibilityConverter x:Key="Visible" />
    <local:DueLabelConverter x:Key="DueText" />
    <local:PickTitleConverter x:Key="PickTitle" />
    <local:AssigneeNameConverter x:Key="AssigneeText" />
    <local:RepeatSummaryConverter x:Key="RepeatText" />
    <local:ReminderStateConverter x:Key="ReminderText" />
    <local:NotVisibleConverter x:Key="NotVisible" />
    <local:WordsConverter x:Key="Words" />
    <local:PasskeyAddedConverter x:Key="PasskeyAdded" />
    <local:FixedWordsConverter x:Key="PasskeyRenameWord" Key="passkeys.rename" />
    <local:FixedWordsConverter x:Key="PasskeyRevokeWord" Key="passkeys.revoke" />
    <local:FilterStateConverter x:Key="FilterText" />
    <local:MessageBylineConverter x:Key="Byline" />
    <local:TimerButtonConverter x:Key="TimerText" />
    <local:StatConverter x:Key="StatFinished" Key="stats.completed" />
    <local:StatConverter x:Key="StatInspired" Key="stats.inspired" />
    <local:StatConverter x:Key="StatSupported" Key="stats.supported" />
    <local:LoggedTimeConverter x:Key="LoggedTime" />
    <local:CredentialStateConverter x:Key="CredentialState" />
    <local:FileGlyphConverter x:Key="FileGlyph" />
    <local:ChipTintConverter x:Key="ChipTint" />
    <local:ChipColourConverter x:Key="ChipColour" />
    <local:FileThumbnailConverter x:Key="FileThumbnail" />
    <local:RemoteImageConverter x:Key="RemoteImage" />
    <local:ChipGlyphConverter x:Key="ChipGlyph" />
    <local:LeadingMarkConverter x:Key="LeadingMark" />
    <local:BubbleAlignConverter x:Key="BubbleAlign" />
    <local:BubbleBrushConverter x:Key="BubbleBrush" />

    <!--
        One sidebar row, shared by My Tasks, the favourites and the lists.

        astrid-web's `ListItem`: a round mark, the name, and a count badge on the right. Its
        selection is a blue tint with blue text rather than Windows' accent bar, and the
        container carries it — a row that painted its own selection would sit inside WinUI's.
    -->
    <!--
        One field row in the task detail, as astrid-web draws them: no button chrome, a 32px
        icon column, and the value where the title is. The icon replaces the word — it keeps
        every row's content starting at the same x, which is what the label was really for, in
        32px rather than 80.
    -->
    <!--
        One of the four priority squares. astrid-web draws them at 40px with the chosen one
        filled and the rest outlined in the same colour; the colours themselves are set in
        code-behind against the current value, because "which of the four is on" is one fact
        and four bindings that each re-derive it is four places to get it wrong.
    -->
    <Style x:Key="PriorityChoice" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A section heading inside the detail pane: small, quiet, and above its content. -->
    <Style x:Key="DetailSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
        <Setter Property="Margin" Value="0,14,0,4" />
    </Style>

    <!-- The round buttons either side of the comment box, as the web's input bar wears them. -->
    <Style x:Key="CommentBarButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DetailField" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="SidebarRowStyle" TargetType="ListViewItem">
        <!--
            Keyboard focus stays visible — it has to — but as a hairline in the accent rather
            than the two-tone black rectangle WinUI draws over the row it indicates.
        -->
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AstridAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="FocusVisualPrimaryThickness" Value="1" />
        <Setter Property="FocusVisualMargin" Value="-1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <local:CompletedOpacityConverter x:Key="CompletedOpacity" />
    <local:CompletedStrikeConverter x:Key="CompletedStrike" />
    <local:CountVisibleConverter x:Key="CountVisible" />
    <local:FilterTintConverter x:Key="FilterTint" />
    <local:BoardColumnWidthConverter x:Key="ColumnWidth" />
    <local:SwatchRingConverter x:Key="SwatchRing" />
    <local:ChoiceLabelConverter x:Key="ChoiceLabel" />
    <local:ReplyIndentConverter x:Key="ReplyIndent" />

    <!-- The small quiet words under a bubble: Reply, Edit, Delete. -->
    <Style x:Key="BubbleAction" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
    </Style>
    <!-- One row of a defaults combo: the choice, named. -->
    <DataTemplate x:Key="DefaultChoiceTemplate" x:DataType="viewmodels:DefaultChoice">
        <TextBlock Text="{x:Bind Converter={StaticResource ChoiceLabel}}" />
    </DataTemplate>
</ResourceDictionary>
