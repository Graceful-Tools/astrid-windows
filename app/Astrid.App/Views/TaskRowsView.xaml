<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.TaskRowsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        Quick add, and the rows under it — the list view of a list. The board is the other view of the
        same work (BoardView), drawn in the same place; the two swap by visibility and nothing else moves.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Quick add, above the rows. The iPhone puts it at the bottom because the
            keyboard rises from there; on a desktop the place you add to a list is the top,
            where you are already looking when you open it.
        -->
        <!--
            Drawn as astrid-web's `quick-add` is: a card of its own, a borderless box on a
            tinted ground inside it, and a square accent button carrying a plus. The word
            "Add" beside a text box is the one thing on the screen that never needed saying.
        -->
        <Border Grid.Row="0" Margin="20,0,20,8"
                VerticalAlignment="Top"
                Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource NotVisible}}"
                Padding="12,10"
                CornerRadius="12"
                Background="{ThemeResource AstridSurface}"
                BorderThickness="1"
                BorderBrush="{ThemeResource AstridBorder}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Uid="quick_add_box" x:Name="QuickAddBox"
                         Grid.Column="0"
                         PlaceholderText="Add a task"
                         Background="{ThemeResource AstridSurfaceHover}"
                         BorderThickness="0"
                         CornerRadius="8"
                         Padding="12,7"
                         KeyDown="OnQuickAddKeyDown" />
                <Button x:Uid="add_a_task" Grid.Column="1"
                        Width="36" Height="36"
                        Padding="0"
                        CornerRadius="8"
                        AutomationProperties.Name="Add"
                        ToolTipService.ToolTip="Add a task"
                        Click="OnQuickAdd"
                        Style="{ThemeResource AccentButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                </Button>
                <!--
                    What just happened, in words, for a moment: the web's "Task created"
                    toast (task 79d4604c). The title is the core's, after any #list tag
                    came out of it.
                -->
                <TextBlock x:Uid="added" Grid.Row="1" Grid.ColumnSpan="2" Margin="4,6,0,0" FontSize="12"
                           Foreground="{ThemeResource AstridTextSecondary}"
                           AutomationProperties.Name="Added"
                           Visibility="{x:Bind Shell.Tasks.HasCreatedNotice, Mode=OneWay, Converter={StaticResource Visible}}">
                    <Run x:Name="AddedPrefix" /><Run Text="&#x201C;" /><Run Text="{x:Bind Shell.Tasks.LastCreatedTitle, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="&#x201D;" />
                </TextBlock>
            </Grid>
        </Border>

        <!--
            The selection is two-way. The keyboard moves it in the view model and the list
            has to follow; clicking a row moves it in the list and the keyboard has to
            follow. One binding rather than two handlers keeping each other in step.
        -->
        <!--
            The rows, as astrid-web draws them.

            Each is a CARD, not a line: 12px radius, a hairline border, a 1px shadow and a
            64px floor, with the mark and the text 12px apart. Those numbers are
            `.task-row` and `.task-card` in astrid-web/styles/components.css rather than
            anything chosen here, so the two clients can be compared side by side and
            corrected against one file.

            The card is the ITEM CONTAINER rather than a Border inside the template. A
            ListViewItem already owns selection, hover and focus; wrapping a card inside one
            leaves WinUI painting its own rectangle behind the web's, which is what made
            these rows look like a list box rather than Astrid.
        -->
        <ListView Grid.Row="1"
                  Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource NotVisible}}"
                  x:Name="TaskRows"
                  IsItemClickEnabled="True"
                  CanDragItems="True"
                  DragItemsStarting="OnRowDragStarting"
                  ItemClick="OnRowClicked"
                  PointerPressed="OnRowsPointerPressed"
                  Margin="12,4,12,0"
                  Padding="0,0,0,12"
                  ItemsSource="{x:Bind Shell.Tasks.Rows, Mode=OneWay}"
                  SelectedItem="{x:Bind Shell.Tasks.Selected, Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionChanged="OnRowSelected"
                  ShowsScrollingPlaceholders="True">
            <ListView.Resources>
                <!--
                    The web tints the whole card on selection and hover and keeps the same
                    thin border — "no blue glow ring, no heavier shadow", as its CSS says.
                    These are the brushes the default ListViewItem template reaches for, so
                    pointing them at the tokens is what makes the container wear the web's
                    states instead of Windows's.
                -->
                <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AstridBgSelected" />
                <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AstridBgSelected" />
                <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AstridBgSelected" />
                <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="AstridSurfaceHover" />
                <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="AstridSurfaceHover" />
                <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="AstridTextPrimary" />
                <!-- The accent bar down the left of a selected row is Windows', not ours. -->
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AstridAccentBrush}" />
                    <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                    <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                    <Setter Property="FocusVisualMargin" Value="-1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="MinHeight" Value="64" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{ThemeResource AstridBorder}" />
                    <Setter Property="Background" Value="{ThemeResource AstridSurface}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="bindings:TaskRow">
                    <Grid ColumnSpacing="12"
                          Margin="{x:Bind Depth, Converter={StaticResource DepthIndent}}"
                          Opacity="{x:Bind Completed, Converter={StaticResource CompletedOpacity}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                            One mark carries three things: priority as its colour, whether
                            it repeats, and whether it is done. The same PNGs astrid-web
                            uses, so a priority reads identically on both.
                        -->
                        <Button Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Width="32" Height="32"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Bind LeadingActionName}"
                                Tag="{x:Bind Id}"
                                Click="OnRowMarkClicked">
                            <!--
                                Whose task is this? Three answers, not two (PRODUCT_CONTRACT.md §4):
                                yours is the checkbox; somebody else's is their mark in a
                                priority-coloured square; nobody's is the unassigned mark in the
                                same square. The core decided which; the tap completes either way.
                            -->
                            <Grid Width="32" Height="32">
                                <Image Source="{x:Bind CheckboxAsset}" Width="32" Height="32"
                                       Visibility="{x:Bind LeadingIsCheckbox, Converter={StaticResource Visible}}" />
                                <!--
                                    A fourth answer (task f6bc59e8): a task in a public list the
                                    reader cannot edit can only be copied, so the mark is the
                                    web's copy control and the tap copies it to their own tasks.
                                -->
                                <Border Width="24" Height="24" CornerRadius="6"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource AstridTextMuted}"
                                        Visibility="{x:Bind LeadingIsCopy, Converter={StaticResource Visible}}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"
                                              Foreground="{ThemeResource AstridTextSecondary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="24" Height="24" CornerRadius="6"
                                        Background="{x:Bind Priority, Converter={StaticResource PriorityBrush}}"
                                        Visibility="{x:Bind LeadingIsSquare, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{x:Bind (bindings:TaskRow), Converter={StaticResource LeadingMark}}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- AST-142, small, as the web draws it. Only when the task has one. -->
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Identifier}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AstridTextMuted}"
                                           Visibility="{x:Bind HasIdentifier, Converter={StaticResource Visible}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Title}"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AstridTextPrimary}"
                                           TextDecorations="{x:Bind Completed, Converter={StaticResource CompletedStrike}}" />
                            </Grid>

                            <!-- The second line only exists when there is something on it. -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind HasSecondLine, Converter={StaticResource Visible}}">
                                <TextBlock Text="{x:Bind Due, Converter={StaticResource DueText}}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AstridTextMuted}"
                                           Visibility="{x:Bind Due.HasDate, Converter={StaticResource Visible}}" />
                                <ItemsControl ItemsSource="{x:Bind ListChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="bindings:ListChip">
                                            <!-- The list's own colour at a tenth strength, as on the web. -->
                                            <Border CornerRadius="4"
                                                    Padding="6,1"
                                                    Background="{x:Bind Color, Converter={StaticResource ChipTint}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{x:Bind IsLabel, Converter={StaticResource ChipGlyph}}"
                                                               FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Foreground="{x:Bind Color, Converter={StaticResource PriorityBrush}}" />
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource AstridTextSecondary}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Uid="not_synced_yet" Text="Not synced yet"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AstridTextMuted}"
                                           Visibility="{x:Bind IsPending, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            Deleting lives here rather than on a button in every row. The
                            web has no per-row delete and it is right not to: a destructive
                            action repeated down the page is one mis-click from a task
                            somebody wanted.
                        -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="delete" Text="Delete"
                                                Tag="{x:Bind Id}"
                                                Click="OnDeleteRow" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
