<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.Settings.IntegrationsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <StackPanel Spacing="10">
        <!--
            Account-wide, not per list: the modes make
            counterparts for every list on both sides, so
            the choice lives beside the account rather than
            in one list's settings.
        -->
        <ComboBox x:Uid="google_sync_mode_box" x:Name="GoogleSyncModeBox"
                  Header="Google lists"
                  AutomationProperties.Name="Google list linking"
                  HorizontalAlignment="Stretch"
                  SelectedItem="{x:Bind Shell.Settings.Integrations.GoogleSyncMode, Mode=OneWay}"
                  Visibility="{x:Bind Shell.GoogleTasksEnabled, Mode=OneWay, Converter={StaticResource Visible}}"
                  SelectionChanged="OnGoogleSyncModeChosen">
            <x:String>manual</x:String>
            <x:String>all_google_to_astrid</x:String>
            <x:String>all_astrid_to_google</x:String>
            <x:String>all_bidirectional</x:String>
        </ComboBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="connect_copilot" Content="Connect Copilot"
                    Click="OnConnectCopilot"
                    Visibility="{x:Bind Shell.Settings.Agents.CopilotConnected, Mode=OneWay, Converter={StaticResource NotVisible}}" />
            <Button x:Uid="disconnect_copilot" Content="Disconnect Copilot"
                    Click="OnDisconnectCopilot"
                    Visibility="{x:Bind Shell.Settings.Agents.CopilotConnected, Mode=OneWay, Converter={StaticResource Visible}}" />
        </StackPanel>

        <!--
            The account's side of external sync (task
            e32f1322): a section per provider, headed by
            which account it is connected as, over the lists
            it mirrors. The core answers all of it in one
            command, so the panel arrives whole rather than
            half drawn.
        -->
        <TextBlock x:Name="PanelUnavailable" TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Foreground="{ThemeResource AstridTextMuted}"
                   Text="{x:Bind Shell.Settings.Integrations.ExternalAccountsUnavailable, Mode=OneWay}"
                   Visibility="{x:Bind Shell.Settings.Integrations.HasExternalAccountsUnavailable, Mode=OneWay, Converter={StaticResource Visible}}" />

        <StackPanel Spacing="6"
                    Visibility="{x:Bind Shell.GoogleTasksEnabled, Mode=OneWay, Converter={StaticResource Visible}}">
            <TextBlock x:Name="GoogleTitle" Margin="0,10,0,0"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AstridTextPrimary}" />
            <TextBlock Foreground="{ThemeResource AstridTextSecondary}"
                       Visibility="{x:Bind Shell.Settings.Integrations.GoogleConnected, Mode=OneWay, Converter={StaticResource Visible}}">
                <Run x:Name="GoogleConnectedAsPrefix" /><Run Text="{x:Bind Shell.Settings.Integrations.GoogleConnectedAs, Mode=OneWay}" />
            </TextBlock>
            <TextBlock x:Name="GoogleNotConnected"
                       Foreground="{ThemeResource AstridTextMuted}"
                       Visibility="{x:Bind Shell.Settings.Integrations.GoogleConnected, Mode=OneWay, Converter={StaticResource NotVisible}}" />
            <TextBlock x:Name="GoogleNoLinks"
                       Foreground="{ThemeResource AstridTextMuted}"
                       Visibility="{x:Bind Shell.Settings.Integrations.HasNoGoogleLinks, Mode=OneWay, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{x:Bind Shell.Settings.Integrations.GoogleLinks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bindings:ExternalAccountLink">
                        <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,3">
                            <TextBlock Text="{x:Bind ListLabel}" />
                            <TextBlock x:Uid="external_link_arrow" Text="&#x2192;"
                                       Foreground="{ThemeResource AstridTextMuted}" />
                            <TextBlock Foreground="{ThemeResource AstridTextSecondary}"
                                       Text="{x:Bind ContainerLabel}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!--
                "New List" binds a NEW Google list to an
                Astrid one, so the picker offers only the
                lists Google has no link for. Pressing it
                twice is safe — the core adopts an unlinked
                Google list of the same name rather than
                making a second one.
            -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Uid="new_google_list_box" x:Name="NewGoogleListBox"
                          Header="Make a Google list for"
                          AutomationProperties.Name="List to make a Google list for"
                          MinWidth="200" DisplayMemberPath="Name"
                          ItemsSource="{x:Bind Shell.Settings.Integrations.LinkableLists, Mode=OneWay}"
                          SelectedItem="{x:Bind Shell.Settings.Integrations.NewGoogleListTarget, Mode=TwoWay}" />
                <Button x:Name="NewGoogleListButton" Click="OnNewGoogleList"
                        VerticalAlignment="Bottom"
                        IsEnabled="{x:Bind Shell.Settings.Integrations.CanCreateGoogleList, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock x:Name="GitHubTitle" Margin="0,10,0,0"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AstridTextPrimary}" />
            <TextBlock Foreground="{ThemeResource AstridTextSecondary}"
                       Visibility="{x:Bind Shell.Settings.Integrations.GitHubConnected, Mode=OneWay, Converter={StaticResource Visible}}">
                <Run x:Name="GitHubConnectedAsPrefix" /><Run Text="{x:Bind Shell.Settings.Integrations.GitHubConnectedAs, Mode=OneWay}" />
            </TextBlock>
            <TextBlock x:Name="GitHubNotConnected"
                       Foreground="{ThemeResource AstridTextMuted}"
                       Visibility="{x:Bind Shell.Settings.Integrations.GitHubConnected, Mode=OneWay, Converter={StaticResource NotVisible}}" />
            <TextBlock x:Name="GitHubNoLinks"
                       Foreground="{ThemeResource AstridTextMuted}"
                       Visibility="{x:Bind Shell.Settings.Integrations.HasNoGitHubLinks, Mode=OneWay, Converter={StaticResource Visible}}" />
            <ItemsControl ItemsSource="{x:Bind Shell.Settings.Integrations.GitHubLinks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bindings:ExternalAccountLink">
                        <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,3">
                            <TextBlock Text="{x:Bind ListLabel}" />
                            <TextBlock x:Uid="external_link_arrow" Text="&#x2192;"
                                       Foreground="{ThemeResource AstridTextMuted}" />
                            <TextBlock Foreground="{ThemeResource AstridTextSecondary}"
                                       Text="{x:Bind ContainerLabel}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
