<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.Settings.ApiAccessSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        API access, as astrid-web's own settings page has
        it. This client is already signed in, so it can
        mint its own credentials rather than sending
        somebody to a browser to do what it is authorised
        for.

        Both plaintexts live only as long as this panel:
        the server stores a hash and shows each once, and a
        secret written to disk is one the account cannot
        rotate by revoking, because nobody knows it is
        there.
    -->
    <StackPanel Spacing="10">
        <TextBlock x:Uid="mcp_token" Text="MCP token" Style="{StaticResource DetailSection}" />
        <TextBlock x:Uid="for_a_coding_agent_or_an" TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{ThemeResource AstridTextMuted}"
                   Text="For a coding agent or an MCP client. Ninety days. Asking twice gives the same token back rather than a second one." />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="create_a_token" Content="Create a token" Click="OnCreateMcpToken" />
            <Button x:Uid="revoke_all" Content="Revoke all" Click="OnRevokeMcpTokens" />
        </StackPanel>
        <!--
            Shown until this panel closes and never
            written down. Selectable so it can be copied,
            which is the only reason it is on screen.
        -->
        <Border CornerRadius="8"
                Padding="10,8"
                Background="{ThemeResource AstridSurfaceHover}"
                Visibility="{x:Bind Shell.Settings.ApiAccess.HasMcpToken, Mode=OneWay, Converter={StaticResource Visible}}">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="copy_this_now_it_is_not" Text="Copy this now — it is not shown again."
                           FontSize="11"
                           Foreground="{ThemeResource AstridTextMuted}" />
                <TextBox x:Uid="mcp_token_2" Text="{x:Bind Shell.Settings.ApiAccess.McpToken, Mode=OneWay}"
                         AutomationProperties.Name="MCP token"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas"
                         TextWrapping="Wrap" />
                <Button x:Uid="copy" Content="Copy" Click="OnCopyMcpToken" />
            </StackPanel>
        </Border>

        <TextBlock x:Uid="client_credentials" Text="Client credentials" Style="{StaticResource DetailSection}" />
        <TextBlock x:Uid="a_pair_for_a_machine_that" TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{ThemeResource AstridTextMuted}"
                   Text="A pair for a machine that is not this one — CI, a script, a runner. Read and write on tasks and lists." />
        <ItemsControl ItemsSource="{x:Bind Shell.Settings.ApiAccess.ApiClients, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="bindings:OAuthClientRow">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AstridTextPrimary}" />
                            <TextBlock Text="{x:Bind ClientId}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AstridTextMuted}" />
                            <TextBlock Text="{x:Bind ScopeLabel}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AstridTextMuted}"
                                       Visibility="{x:Bind ScopeLabel, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <Button x:Uid="revoke" Grid.Column="1" Content="Revoke"
                                VerticalAlignment="Top"
                                Tag="{x:Bind ClientId}"
                                Click="OnDeleteOAuthClient" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Uid="what_it_is_for" AutomationProperties.Name="New client name"
                     PlaceholderText="what it is for"
                     Width="200"
                     Text="{x:Bind Shell.Settings.ApiAccess.NewClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Uid="register" Content="Register"
                    IsEnabled="{x:Bind Shell.Settings.ApiAccess.CanCreateClient, Mode=OneWay}"
                    Click="OnCreateOAuthClient" />
        </StackPanel>
        <Border CornerRadius="8"
                Padding="10,8"
                Background="{ThemeResource AstridSurfaceHover}"
                Visibility="{x:Bind Shell.Settings.ApiAccess.HasMintedClient, Mode=OneWay, Converter={StaticResource Visible}}">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="copy_the_secret_now_it_is" Text="Copy the secret now — it is not shown again."
                           FontSize="11"
                           Foreground="{ThemeResource AstridTextMuted}" />
                <TextBox x:Uid="client_id" Text="{x:Bind Shell.Settings.ApiAccess.MintedClient.ClientId, Mode=OneWay}"
                         AutomationProperties.Name="Client id"
                         Header="Client id"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas"
                         TextWrapping="Wrap" />
                <TextBox x:Uid="client_secret" Text="{x:Bind Shell.Settings.ApiAccess.MintedClient.ClientSecret, Mode=OneWay}"
                         AutomationProperties.Name="Client secret"
                         Header="Client secret"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas"
                         TextWrapping="Wrap" />
                <Button x:Uid="copy_the_pair" Content="Copy the pair" Click="OnCopyMintedClient" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
