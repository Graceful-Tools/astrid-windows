<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.Settings.AccountSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <StackPanel Spacing="10">
        <!--
            Sync and sign out belong to the account, and
            putting them here is what leaves the list's own
            toolbar room to exist. astrid-web has one
            control up there too.
        -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="sync_now" Content="Sync now" Click="OnSync" />
            <Button x:Uid="sign_out" Content="Sign out" Click="OnSignOut" />
        </StackPanel>

        <!--
            The web's AccountSettings, section by section
            (task 19fd9289). The words are set in
            WordAccountSection so they come from the
            strings table like everything else new.
        -->
        <TextBlock x:Name="ProfileTitle" Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource AstridTextPrimary}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="56" Height="56" CornerRadius="28"
                    Background="{ThemeResource AstridBorder}">
                <Image x:Uid="profile_photo" Source="{x:Bind Shell.Settings.PhotoUrl, Mode=OneWay, Converter={StaticResource RemoteImage}}"
                       Stretch="UniformToFill"
                       AutomationProperties.Name="Profile photo" />
            </Border>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <Button x:Name="ChangePhotoButton" Click="OnChangePhoto" />
                <TextBlock x:Name="PhotoHint" FontSize="11"
                           Foreground="{ThemeResource AstridTextMuted}" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Uid="display_name_box" x:Name="DisplayNameBox" Width="260"
                     AutomationProperties.Name="Display name"
                     Text="{x:Bind Shell.Settings.NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="SaveNameButton" Click="OnSaveName"
                    VerticalAlignment="Bottom"
                    IsEnabled="{x:Bind Shell.Settings.CanSaveName, Mode=OneWay}" />
        </StackPanel>
        <TextBlock Text="{x:Bind Shell.Settings.Email, Mode=OneWay}"
                   Foreground="{ThemeResource AstridTextSecondary}" />

        <TextBlock x:Name="VerificationTitle" Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource AstridTextPrimary}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Uid="verification_state" VerticalAlignment="Center"
                       AutomationProperties.Name="Verification state"
                       Text="{x:Bind Shell.Settings.VerificationKey, Mode=OneWay, Converter={StaticResource Words}}" />
            <Button x:Name="ResendButton" Click="OnResendVerification"
                    Visibility="{x:Bind Shell.Settings.IsVerified, Mode=OneWay, Converter={StaticResource NotVisible}}" />
        </StackPanel>
        <TextBlock Foreground="{ThemeResource AstridTextSecondary}"
                   Visibility="{x:Bind Shell.Settings.HasPendingEmail, Mode=OneWay, Converter={StaticResource Visible}}">
            <Run x:Name="PendingPrefix" /><Run Text="{x:Bind Shell.Settings.PendingEmail, Mode=OneWay}" />
        </TextBlock>
        <TextBlock x:Name="VerificationSentLine" TextWrapping="Wrap"
                   Foreground="{ThemeResource AstridTextSecondary}"
                   Visibility="{x:Bind Shell.Settings.VerificationSent, Mode=OneWay, Converter={StaticResource Visible}}" />

        <TextBlock x:Name="InfoTitle" Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource AstridTextPrimary}" />
        <Grid ColumnSpacing="16" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="InfoCreatedLabel" Grid.Row="0" Grid.Column="0"
                       Foreground="{ThemeResource AstridTextMuted}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{x:Bind Shell.Settings.CreatedOn, Mode=OneWay}" />
            <TextBlock x:Name="InfoUpdatedLabel" Grid.Row="1" Grid.Column="0"
                       Foreground="{ThemeResource AstridTextMuted}" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{x:Bind Shell.Settings.UpdatedOn, Mode=OneWay}" />
            <TextBlock x:Name="InfoIdLabel" Grid.Row="2" Grid.Column="0"
                       Foreground="{ThemeResource AstridTextMuted}" />
            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11"
                       FontFamily="Consolas" IsTextSelectionEnabled="True"
                       Text="{x:Bind Shell.Settings.AccountId, Mode=OneWay}" />
        </Grid>

        <TextBlock x:Name="PasskeysTitle" Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource AstridTextPrimary}" />
        <TextBlock x:Name="PasskeysNote" TextWrapping="Wrap"
                   Foreground="{ThemeResource AstridTextSecondary}" />
        <!--
            The list the web's PasskeyManagementSection draws,
            over the v1 route the web added for it (task
            19fd9289, web c4ad9e68). Adding one is a
            WebAuthn ceremony and stays in the browser.
        -->
        <TextBlock TextWrapping="Wrap"
                   Foreground="{ThemeResource AstridTextMuted}"
                   Text="{x:Bind Shell.Settings.PasskeysUnavailable, Mode=OneWay}"
                   Visibility="{x:Bind Shell.Settings.HasPasskeysUnavailable, Mode=OneWay, Converter={StaticResource Visible}}" />
        <TextBlock x:Name="PasskeysEmpty"
                   Foreground="{ThemeResource AstridTextMuted}"
                   Visibility="{x:Bind Shell.Settings.HasNoPasskeys, Mode=OneWay, Converter={StaticResource Visible}}" />
        <ItemsControl ItemsSource="{x:Bind Shell.Settings.Passkeys, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="bindings:PasskeySummary">
                    <Grid ColumnSpacing="8" Padding="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind Label}" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource AstridTextMuted}"
                                       Text="{x:Bind CreatedAt, Converter={StaticResource PasskeyAdded}}" />
                        </StackPanel>
                        <Button x:Uid="rename_passkey" Grid.Column="1" Tag="{x:Bind Id}" Click="OnRenamePasskey"
                                Style="{StaticResource BubbleAction}"
                                AutomationProperties.Name="Rename passkey"
                                Content="{x:Bind Converter={StaticResource PasskeyRenameWord}}" />
                        <Button x:Uid="revoke_passkey" Grid.Column="2" Tag="{x:Bind Id}" Click="OnRevokePasskey"
                                Style="{StaticResource BubbleAction}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                AutomationProperties.Name="Revoke passkey"
                                Content="{x:Bind Converter={StaticResource PasskeyRevokeWord}}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="ManagePasskeysButton" Click="OnManagePasskeys" />

        <TextBlock x:Name="DeleteTitle" Margin="0,10,0,0"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="DeleteWarning" TextWrapping="Wrap"
                   Foreground="{ThemeResource AstridTextSecondary}" />
        <TextBox x:Uid="delete_confirmation_box" x:Name="DeleteConfirmationBox" Width="260"
                 HorizontalAlignment="Left"
                 AutomationProperties.Name="Delete confirmation"
                 Text="{x:Bind Shell.Settings.DeleteConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Name="DeleteAccountButton" Click="OnDeleteAccount"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                IsEnabled="{x:Bind Shell.Settings.CanDeleteAccount, Mode=OneWay}" />
    </StackPanel>
</UserControl>
