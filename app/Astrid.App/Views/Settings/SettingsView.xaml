<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <UserControl.Resources>
        <!--
            One category of the hub, as astrid-web's SettingsHub draws it: a card with the icon
            in a tinted square, a title, a line about it, and a chevron. The selected one is the
            page on the right.
        -->
        <Style x:Key="SettingsCardStyle" TargetType="ListViewItem" BasedOn="{StaticResource SidebarRowStyle}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AstridBorder}" />
            <Setter Property="Background" Value="{ThemeResource AstridSurfaceHover}" />
        </Style>
        <Style x:Key="CardIconWell" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource AstridSurface}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AstridTextPrimary}" />
        </Style>
        <Style x:Key="CardLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
        </Style>
        <Style x:Key="CardChevron" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource AstridTextMuted}" />
        </Style>
    </UserControl.Resources>

    <!--
        Settings, over the whole window, laid out as astrid-web lays them out (task 3f5834ed).

        The web takes settings over its main surface: a hub — "Settings", a line under it, then
        one card per category — with the chosen page opening beside it, each page under its own
        header of icon, title and a line about it (components/TaskManagerView.tsx,
        `layout.mainSurface === 'settings'`; Settings/SettingsHub.tsx; the pages under
        Settings/). The full-page route adds a bar with a way back.

        This used to be a 720×540 flyout under the account button, which the whole of a
        settings page had to fit inside. Now it covers the window, under the palette and the
        tour and over everything else, and the list is exactly where it was when the bar's
        arrow is pressed. The sections themselves are the same controls they were.
    -->
    <Grid x:Name="SettingsLayer"
          Background="{ThemeResource AstridSurface}"
          Visibility="{x:Bind Shell.IsSettingsOpen, Mode=OneWay, Converter={StaticResource Visible}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The bar: the way back, and what this is. -->
        <Grid Grid.Row="0"
              Padding="12,8"
              ColumnSpacing="8"
              BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource AstridBorder}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="settings_back" Grid.Column="0" x:Name="BackButton"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                    Click="OnBack">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Uid="settings_title" Grid.Column="1" Text="Settings"
                       FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource AstridTextPrimary}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The hub. -->
            <Grid Grid.Column="0"
                  Padding="20,20,20,0"
                  BorderThickness="0,0,1,0"
                  BorderBrush="{ThemeResource AstridBorder}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The web's header: the brand square, the word, and what the page is for. -->
                <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                            VerticalAlignment="Top" Margin="0,4,0,0"
                            Background="{ThemeResource AstridAccentBrush}">
                        <Border Width="14" Height="14" CornerRadius="3" Background="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="settings_heading" Text="Settings"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{ThemeResource AstridTextPrimary}" />
                        <TextBlock x:Uid="settings_subtitle" Text="Manage your account and preferences"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource AstridTextMuted}" />
                    </StackPanel>
                </Grid>

                <!-- Whose settings: the name, the address, and the three numbers from the server. -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,16">
                    <TextBlock Text="{x:Bind Shell.Settings.Account.DisplayName, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource AstridTextPrimary}" />
                    <TextBlock Text="{x:Bind Shell.Settings.Account.Email, Mode=OneWay}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource AstridTextMuted}" />
                    <!--
                        The three numbers, from the server: they are about the whole account
                        across every device, so a client counting its own cache would answer
                        with whatever it happens to hold.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind Shell.Settings.Account.Stats, Mode=OneWay, Converter={StaticResource StatFinished}}"
                                   FontSize="11"
                                   Foreground="{ThemeResource AstridTextMuted}" />
                        <TextBlock Text="{x:Bind Shell.Settings.Account.Stats, Mode=OneWay, Converter={StaticResource StatInspired}}"
                                   FontSize="11"
                                   Foreground="{ThemeResource AstridTextMuted}" />
                        <TextBlock Text="{x:Bind Shell.Settings.Account.Stats, Mode=OneWay, Converter={StaticResource StatSupported}}"
                                   FontSize="11"
                                   Foreground="{ThemeResource AstridTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!--
                    The categories, in the web's order where the web has them. The lines under
                    the titles are set in the code-behind from the strings table, the same words
                    the page header on the right wears.
                -->
                <ListView x:Uid="settings_sections" Grid.Row="2"
                          x:Name="SettingsSections"
                          AutomationProperties.Name="Settings sections"
                          SelectionMode="Single"
                          Padding="0,0,0,20"
                          ItemContainerStyle="{StaticResource SettingsCardStyle}"
                          SelectionChanged="OnSettingsSectionChosen">
                    <ListViewItem x:Uid="account" Tag="Account" AutomationProperties.Name="Account">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE77B;" Style="{StaticResource CardIcon}" Foreground="#3B82F6" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="account_2" Text="Account" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AccountCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="reminders" Tag="Reminders" AutomationProperties.Name="Reminders">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xEA8F;" Style="{StaticResource CardIcon}" Foreground="#F97316" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="reminders_2" Text="Reminders" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="RemindersCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="tasks" Tag="Tasks" AutomationProperties.Name="Tasks">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE73A;" Style="{StaticResource CardIcon}" Foreground="#3B82F6" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="tasks_nav_label" x:Name="TasksNavLabel" Text="Tasks" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TasksCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="ai_agents" Tag="Agents" AutomationProperties.Name="AI agents">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE99A;" Style="{StaticResource CardIcon}" Foreground="#A855F7" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="ai_agents_2" Text="AI agents" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AgentsCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="api_access" Tag="ApiAccess" AutomationProperties.Name="API access">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE192;" Style="{StaticResource CardIcon}" Foreground="#2563EB" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="api_access_2" Text="API access" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ApiAccessCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="contacts" Tag="Contacts" AutomationProperties.Name="Contacts">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE716;" Style="{StaticResource CardIcon}" Foreground="#14B8A6" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="contacts_nav_label" x:Name="ContactsNavLabel" Text="Contacts" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ContactsCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="appearance" Tag="Appearance" AutomationProperties.Name="Appearance">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIcon}" Foreground="#EC4899" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="appearance_2" Text="Appearance" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AppearanceCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="integrations" Tag="Integrations" AutomationProperties.Name="Integrations">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE704;" Style="{StaticResource CardIcon}" Foreground="#10B981" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="integrations_2" Text="Integrations" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="IntegrationsCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="your_data" Tag="Data" AutomationProperties.Name="Your data">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIcon}" Foreground="#059669" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="your_data_2" Text="Your data" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="DataCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                        </Grid>
                    </ListViewItem>
                    <!--
                        The web's last three (task 438494c7): Help, Privacy and Terms open the
                        web's own pages in the browser, so there is one copy of each — and the
                        Store's checklist has its privacy policy reachable from inside the app.
                        They wear an outward arrow instead of a chevron, being doors rather than
                        pages.
                    -->
                    <ListViewItem x:Uid="help_and_support" Tag="Help" AutomationProperties.Name="Help and support">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE897;" Style="{StaticResource CardIcon}" Foreground="#06B6D4" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="help_nav_label" x:Name="HelpNavLabel" Text="Help &amp; Support" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="HelpCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" Glyph="&#xE8A7;" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="privacy_policy" Tag="Privacy" AutomationProperties.Name="Privacy policy">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE72E;" Style="{StaticResource CardIcon}" Foreground="#6B7280" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="privacy_nav_label" x:Name="PrivacyNavLabel" Text="Privacy Policy" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="PrivacyCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" Glyph="&#xE8A7;" />
                        </Grid>
                    </ListViewItem>
                    <ListViewItem x:Uid="terms_of_service" Tag="Terms" AutomationProperties.Name="Terms of service">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardIconWell}">
                                <FontIcon Glyph="&#xE8A5;" Style="{StaticResource CardIcon}" Foreground="#6B7280" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="terms_nav_label" x:Name="TermsNavLabel" Text="Terms of Service" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="TermsCardLine" Style="{StaticResource CardLine}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" Glyph="&#xE8A7;" />
                        </Grid>
                    </ListViewItem>
                </ListView>
            </Grid>

            <!--
                The page, as the web's pages are framed: centred, no wider than reads well, with
                the icon, the title and the line about it above the sections.
            -->
            <ScrollViewer Grid.Column="1" Padding="40,28,40,40">
                <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="14" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" x:Name="SettingsSectionIcon"
                                  Glyph="&#xE77B;" FontSize="28"
                                  VerticalAlignment="Center"
                                  Foreground="#3B82F6" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="settings_section_title" x:Name="SettingsSectionTitle"
                                       Text="Account"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AstridTextPrimary}" />
                            <TextBlock x:Name="SettingsSectionLine"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AstridTextMuted}" />
                        </StackPanel>
                    </Grid>

                    <settings:AccountSection x:Name="AccountSection" />
                    <settings:TasksSection x:Name="TasksSection" Visibility="Collapsed" />
                    <settings:ContactsSection x:Name="ContactsSection" Visibility="Collapsed" />
                    <settings:RemindersSection x:Name="RemindersSection" Visibility="Collapsed" />
                    <settings:AppearanceSection x:Name="AppearanceSection" Visibility="Collapsed" />
                    <settings:AgentsSection x:Name="AgentsSection" Visibility="Collapsed" />
                    <settings:ApiAccessSection x:Name="ApiAccessSection" Visibility="Collapsed" />
                    <settings:IntegrationsSection x:Name="IntegrationsSection" Visibility="Collapsed" />
                    <settings:DataSection x:Name="DataSection" Visibility="Collapsed" />

                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Text="{x:Bind Shell.Settings.ErrorMessage, Mode=OneWay}"
                               Visibility="{x:Bind Shell.Settings.ErrorMessage, Mode=OneWay, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
