<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.Settings.RemindersSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <StackPanel Spacing="10">
        <ToggleSwitch x:Uid="push_toggle" x:Name="PushToggle"
                      Header="Push reminders"
                      AutomationProperties.Name="Push reminders"
                      IsOn="{x:Bind Shell.Settings.Reminders.PushEnabled, Mode=OneWay}"
                      Toggled="OnPushToggled" />
        <ToggleSwitch x:Uid="email_toggle" x:Name="EmailToggle"
                      Header="Email reminders"
                      AutomationProperties.Name="Email reminders"
                      IsOn="{x:Bind Shell.Settings.Reminders.EmailEnabled, Mode=OneWay}"
                      Toggled="OnEmailToggled" />
        <ComboBox x:Uid="default_offset_box" x:Name="DefaultOffsetBox"
                  Header="Remind me by default"
                  AutomationProperties.Name="Default reminder"
                  ItemsSource="{x:Bind Shell.Settings.Reminders.Offsets, Mode=OneWay}"
                  SelectionChanged="OnDefaultOffsetChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="bindings:ReminderOffset">
                    <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock x:Uid="daily_digest" Text="Daily digest" Style="{StaticResource DetailSection}" />
        <ToggleSwitch x:Uid="digest_toggle" x:Name="DigestToggle"
                      Header="Send a daily digest"
                      AutomationProperties.Name="Daily digest"
                      IsOn="{x:Bind Shell.Settings.Reminders.DigestEnabled, Mode=OneWay}"
                      Toggled="OnDigestToggled" />
        <TimePicker x:Uid="digest_time_box" x:Name="DigestTimeBox"
                    Header="At"
                    AutomationProperties.Name="Digest time"
                    SelectedTimeChanged="OnDigestTimeChanged" />

        <TextBlock x:Uid="quiet_hours" Text="Quiet hours" Style="{StaticResource DetailSection}" />
        <ToggleSwitch x:Uid="quiet_toggle" x:Name="QuietToggle"
                      Header="No reminders overnight"
                      AutomationProperties.Name="Quiet hours"
                      IsOn="{x:Bind Shell.Settings.Reminders.QuietHoursEnabled, Mode=OneWay}"
                      Toggled="OnQuietHoursToggled" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TimePicker x:Uid="quiet_start_box" x:Name="QuietStartBox" Header="From"
                        AutomationProperties.Name="Quiet from"
                        SelectedTimeChanged="OnQuietHoursChanged" />
            <TimePicker x:Uid="quiet_end_box" x:Name="QuietEndBox" Header="Until"
                        AutomationProperties.Name="Quiet until"
                        SelectedTimeChanged="OnQuietHoursChanged" />
        </StackPanel>

        <!--
            The calendar feed (task 28c5c6a9), as the web's Reminders page carries it: a switch,
            what to include, and the address to paste into a calendar app. Gated as the web gates
            it — the choice only once sync is on, the address only once something is included.
        -->
        <TextBlock x:Uid="calendar_heading" Text="Calendar" Style="{StaticResource DetailSection}" />
        <ToggleSwitch x:Uid="calendar_sync_toggle" x:Name="CalendarSyncToggle"
                      Header="Sync with your calendar"
                      OnContent="On" OffContent="Off"
                      AutomationProperties.Name="Calendar sync"
                      IsOn="{x:Bind Shell.Settings.Reminders.CalendarSyncEnabled, Mode=OneWay}"
                      Toggled="OnCalendarSyncToggled" />
        <StackPanel Spacing="10"
                    Visibility="{x:Bind Shell.Settings.Reminders.CalendarSyncEnabled, Mode=OneWay, Converter={StaticResource Visible}}">
            <ComboBox x:Uid="calendar_sync_type_box" x:Name="CalendarSyncTypeBox"
                      Header="What to include"
                      AutomationProperties.Name="What to include in the calendar"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind Shell.Settings.Reminders.CalendarSyncChoices, Mode=OneWay}"
                      ItemTemplate="{StaticResource DefaultChoiceTemplate}"
                      SelectedItem="{x:Bind Shell.Settings.Reminders.SelectedCalendarSyncChoice, Mode=OneWay}"
                      SelectionChanged="OnCalendarSyncTypeChosen" />
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource AstridTextMuted}"
                       Text="{x:Bind Shell.Settings.Reminders.CalendarSyncDescriptionKey, Mode=OneWay, Converter={StaticResource Words}}" />
            <StackPanel Spacing="4"
                        Visibility="{x:Bind Shell.Settings.Reminders.HasCalendarFeed, Mode=OneWay, Converter={StaticResource Visible}}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Uid="calendar_feed_box" Grid.Column="0"
                             AutomationProperties.Name="Calendar feed address"
                             IsReadOnly="True"
                             FontSize="12"
                             FontFamily="Consolas"
                             Text="{x:Bind Shell.Settings.Reminders.CalendarFeedUrl, Mode=OneWay}" />
                    <Button x:Uid="copy_calendar_feed" Grid.Column="1" Content="Copy"
                            AutomationProperties.Name="Copy calendar feed"
                            VerticalAlignment="Bottom"
                            Click="OnCopyCalendarFeed" />
                </Grid>
                <TextBlock x:Uid="calendar_feed_hint" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource AstridTextMuted}"
                           Text="Paste this address into your calendar app to subscribe. It updates as your tasks change." />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
