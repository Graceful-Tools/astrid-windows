<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.Settings.TasksSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The web's Task Settings page (task c0f3db19). The
        due date and time are for tasks created by email,
        as they are on the web; quick add does not read
        them on either client.
    -->
    <StackPanel Spacing="10">
        <ToggleSwitch x:Uid="email_to_task_toggle" x:Name="EmailToTaskToggle"
                      AutomationProperties.Name="Email-to-Task"
                      IsOn="{x:Bind Shell.Settings.EmailToTaskEnabled, Mode=OneWay}"
                      Toggled="OnEmailToTaskToggled" />
        <TextBlock Foreground="{ThemeResource AstridTextSecondary}" TextWrapping="Wrap">
            <Run x:Name="EmailToTaskHint" /><Run Text=" " /><Run x:Name="EmailToTaskAddress" FontWeight="SemiBold" />
        </TextBlock>
        <ComboBox x:Uid="due_offset_box" x:Name="DueOffsetBox"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Default due date"
                  ItemsSource="{x:Bind Shell.Settings.DueOffsetChoices, Mode=OneWay}"
                  ItemTemplate="{StaticResource DefaultChoiceTemplate}"
                  SelectedItem="{x:Bind Shell.Settings.SelectedDueOffset, Mode=OneWay}"
                  SelectionChanged="OnSmartTaskChoiceChosen" />
        <TextBlock x:Name="DueOffsetHint" FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource AstridTextMuted}" />
        <ComboBox x:Uid="due_time_box" x:Name="DueTimeBox"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Default due time"
                  ItemsSource="{x:Bind Shell.Settings.DueTimeChoices, Mode=OneWay}"
                  ItemTemplate="{StaticResource DefaultChoiceTemplate}"
                  SelectedItem="{x:Bind Shell.Settings.SelectedDueTime, Mode=OneWay}"
                  SelectionChanged="OnSmartTaskChoiceChosen" />
        <TextBlock x:Name="DueTimeHint" FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource AstridTextMuted}" />
    </StackPanel>
</UserControl>
