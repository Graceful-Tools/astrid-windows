<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The board view of a list: one column per status, cards inside them, and the slot the expanded
        card's detail is drawn in. It takes the place the quick-add and the rows take in list view.
    -->

    <UserControl.Resources>
        <!--
            A board card, and the slot the expanded card's detail is drawn in (task 91a25b8a).

            astrid-web's board opens a tapped card IN PLACE: the task detail grows out of the card
            inside its column rather than in the side panel the list uses. The column's items are
            the cards with one slot among them, and the selector below draws each with the right
            template. The slot is an empty ContentControl; the code-behind moves the page's one
            detail pane into it when it loads, so the board and the list share one detail.
        -->
        <DataTemplate x:Key="BoardCardTemplate" x:DataType="bindings:TaskRow">
            <!--
                The same card the list draws, because it is the same task: 10px radius, a
                hairline border, and the surface the rows sit on. A BoardCard rather than a
                Button because WinUI never starts a drag from a Button (task b8e42e70); it is
                still one, so a click, the keyboard and a screen reader keep everything.
            -->
            <views:BoardCard HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="0,0,0,6"
                    Padding="10,8"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AstridBorder}"
                    Background="{ThemeResource AstridSurface}"
                    Tag="{x:Bind Id}"
                    AutomationProperties.Name="{x:Bind Title}"
                    CanDrag="True"
                    DragStarting="OnCardDragStarting"
                    Click="OnCardOpened"
                    RightTapped="OnCardRightTapped">
                <!--
                    The same two columns a list row draws: the mark, then the words (task
                    6979e694). A card without one put the title hard against the card edge and
                    moved it the moment the card was opened — the Mac avoids that by building its
                    card out of its row view, and the web shares `TaskRowContent` for the same
                    reason. This is that shape, 32px mark and a 12px gap, without pulling the
                    row's second line onto a card.
                -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                        One mark carries three things, as on a row: priority as its colour, whether
                        it repeats, and whether it is done. The core decided which of the three a
                        task gets, so a card and a row cannot disagree about one task.
                    -->
                    <Button Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Width="32" Height="32"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{x:Bind LeadingActionName}"
                            Tag="{x:Bind Id}"
                            Click="OnCardMarkClicked">
                        <Grid Width="32" Height="32">
                            <local:PriorityMark Priority="{x:Bind Priority}"
                                                IsRepeating="{x:Bind IsRepeating}"
                                                ShowTick="{x:Bind Completed}"
                                                Width="32" Height="32"
                                                Visibility="{x:Bind LeadingIsCheckbox, Converter={StaticResource Visible}}" />
                            <!-- A task in a public list the reader cannot edit: the tap copies. -->
                            <Border Width="24" Height="24" CornerRadius="6"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource AstridTextMuted}"
                                    Visibility="{x:Bind LeadingIsCopy, Converter={StaticResource Visible}}">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11"
                                          Foreground="{ThemeResource AstridTextSecondary}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="24" Height="24" CornerRadius="6"
                                    BorderThickness="2"
                                    local:PriorityOutline.Priority="{x:Bind Priority}"
                                    Visibility="{x:Bind LeadingIsPlainSquare, Converter={StaticResource Visible}}">
                                <TextBlock Text="{x:Bind (bindings:TaskRow), Converter={StaticResource LeadingMark}}"
                                           FontSize="12" FontWeight="SemiBold"
                                           local:PriorityOutline.Priority="{x:Bind Priority}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!--
                                ...and when that task repeats, the arrows are its border
                                (task fa63a5dd). Only your own mark could say "repeats",
                                because it is one PNG that draws priority, repeating and done
                                together; the other two are built out of controls and had
                                nowhere to say it. The arrows are drawn at the full 32 the
                                own-task mark uses, from the same art, with the mark inside
                                the loop — and they carry the priority here, which is why the
                                mark itself goes neutral.
                            -->
                            <Grid Width="32" Height="32"
                                  Visibility="{x:Bind LeadingIsRepeatSquare, Converter={StaticResource Visible}}">
                                <local:PriorityMark Priority="{x:Bind Priority}"
                                                    IsRepeating="True"
                                                    Width="32" Height="32" />
                                <!--
                                    14, not 0.6 of the frame as the web draws it: the art is a
                                    56px canvas with inset ink, so a 32 frame leaves a hollow of
                                    about 17 between the arrows. A mark any wider covers the
                                    stroke and reads as a circle sitting on a bracket. Pinned to
                                    the shipped image by a test.
                                -->
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{ThemeResource AstridBorderHover}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind (bindings:TaskRow), Converter={StaticResource LeadingMark}}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AstridTextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <!--
                            The key, muted, above the title (task 99da12e0). This is the one
                            surface where it earns its place: on a board the key is shared
                            context, and a card is where somebody reads an id out to quote it.
                            `ShowsIdentifier` is the core's answer, so a card and a list row
                            cannot disagree about one task.
                        -->
                        <TextBlock Text="{x:Bind Identifier}"
                                   FontSize="11"
                                   Foreground="{ThemeResource AstridTextMuted}"
                                   Visibility="{x:Bind ShowsIdentifier, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{x:Bind Title}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource AstridTextPrimary}"
                                   TextDecorations="{x:Bind Completed, Converter={StaticResource CompletedStrike}}" />
                        <!--
                            The day it was finished, as a pill directly under the title — Done's
                            cards only (Jon, 2026-11-19). The column copies the day onto its
                            cards; every other column leaves it empty and draws nothing. The words
                            are "✓ on Nov 19" (board.card.completed_pill), the check in them so it
                            takes the pill's ink; a screen reader hears "Completed Nov 19"
                            (board.card.completed_on) rather than the glyph.
                        -->
                        <Border Style="{StaticResource DonePillStyle}"
                                Visibility="{x:Bind ShowsCompletedPill, Converter={StaticResource Visible}}">
                            <TextBlock Text="{x:Bind CompletedPill, Converter={StaticResource CompletedPillWords}}"
                                       AutomationProperties.Name="{x:Bind CompletedPill, Converter={StaticResource CompletedPillName}}"
                                       Style="{StaticResource DonePillTextStyle}" />
                        </Border>
                        <TextBlock Text="{x:Bind Due, Converter={StaticResource DueText}}"
                                   FontSize="11"
                                   Foreground="{ThemeResource AstridTextMuted}" />
                    </StackPanel>
                </Grid>
            </views:BoardCard>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The board. One column per status, cards inside them, and a menu on each card to
            move it — a drag is the gesture people expect, and it will come, but a card that
            can only be dragged is a card a keyboard cannot move at all.
        -->
        <!--
            A list that belongs to no board. Whether it does is only known once the board
            has been asked for, so the toggle is offered everywhere — and a blank pane
            behind it reads as a board that failed to load rather than one that was never
            there.
        -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Shell.ShowsNoBoardNotice, Mode=OneWay, Converter={StaticResource Visible}}">
            <TextBlock Text="&#xE80A;"
                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource AstridTextMuted}" />
            <TextBlock x:Uid="this_list_has_no_board" Text="This list has no board"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource AstridTextSecondary}" />
            <TextBlock Text="{x:Bind local:BrandCopy.BoardTurnOneOn}"
                       FontSize="12"
                       MaxWidth="320"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource AstridTextMuted}" />
        </StackPanel>

        <!--
            The board fills the rows the quick-add and the list would take, and is told its
            height: VerticalScrollBarVisibility="Disabled" is what makes a ScrollViewer
            measure its content against the viewport rather than infinity. Without it every
            column was as tall as its cards and a long one ran off the bottom of the window
            with nothing to scroll it. Each column scrolls its own cards instead, as the
            web's do — which is also what makes room for a card opened in place.
        -->
        <!--
            The board's goals and guardrails (task ec11e539), in the row above the columns. It
            draws nothing for a board with none, so the columns keep the whole height then.
        -->
        <Grid Grid.Row="0"
              Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource Visible}}">
            <Grid Style="{StaticResource BoardToolbarStyle}"
                  Visibility="{x:Bind Shell.Board.Goals.IsShown, Mode=OneWay, Converter={StaticResource Visible}}">
                <views:GoalsButton HorizontalAlignment="Left" Goals="{x:Bind Shell.Board.Goals}" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="ColumnsScroller"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Disabled"
                      Margin="12,0,12,8"
                      Visibility="{x:Bind Shell.IsBoardView, Mode=OneWay, Converter={StaticResource Visible}}">
            <ItemsControl x:Name="ColumnsHost"
                          ItemsSource="{x:Bind Shell.Board.Columns, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BoardColumnView">
                        <!--
                            A column takes a dropped card. The menu on each card does the
                            same thing and is what a keyboard can reach; the drag is what
                            everybody expects from a board.

                            The column holding the expanded card is wider, as the web's
                            grows towards its upper bound, so the detail's rows keep the
                            layout they have in the side pane.
                        -->
                        <Border Width="288"
                                CornerRadius="8"
                                AllowDrop="True"
                                Tag="{x:Bind Id}"
                                DragOver="OnCardDragOver"
                                Drop="OnCardDropped"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource AstridBorder}"
                                Background="{ThemeResource AstridSurfaceHover}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!--
                                    The column head, as astrid-web draws it: the name, the
                                    number in it as a pill on the right, the description
                                    under both, and a rule below the lot.
                                -->
                                <Border Grid.Row="0"
                                        Padding="12,8"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource AstridBorder}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <!-- The name alone: the count is the pill
                                                 beside it, and saying it twice is how a
                                                 column comes to read "Inbox (15) 15". -->
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource AstridTextPrimary}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AstridTextMuted}"
                                                       Visibility="{x:Bind Description, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                CornerRadius="10"
                                                Padding="8,1"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource AstridSurface}">
                                            <!-- Every card in the column, not just the
                                                 ones loaded — the same distinction the
                                                 list's own total makes. -->
                                            <TextBlock Text="{x:Bind Total}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource AstridTextSecondary}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled">
                                    <StackPanel Padding="8">
                                        <!--
                                            An empty column says so. A column that is
                                            simply blank looks the same as one whose cards
                                            did not arrive.
                                        -->
                                        <Border MinHeight="72"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource AstridBorder}"
                                                Visibility="{x:Bind Cards.Count, Converter={StaticResource CountVisible}, ConverterParameter=empty}">
                                            <TextBlock x:Uid="nothing_here_yet" Text="Nothing here yet"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource AstridTextMuted}" />
                                        </Border>

                                        <!--
                                            Just the cards. The open one's detail is a CALLOUT
                                            anchored to its card (task eb2684bb), not a slot
                                            spliced in among them, so opening a card moves
                                            nothing in the column.
                                        -->
                                        <ItemsControl ItemsSource="{x:Bind Cards}"
                                                      ItemTemplate="{StaticResource BoardCardTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!--
                                    The add field, at the BOTTOM of the column and outside the
                                    card scroller — the Mac's placement, and the iPad's and the
                                    web's. The header keeps row 0 and this keeps row 2, so the
                                    cards scroll between them rather than carrying either away.

                                    What a card typed here is made of is mostly the core's: the
                                    column decides the lists, the role, and whether Done means it
                                    is already done. What the reader decides is the priority and
                                    the assignee, through the picker beside the box - the same two
                                    the list's own field offers (task 71ad20a0).

                                    NOT smart parsing, deliberately (Jon, 2026-11-14): the column
                                    already decides the list and completion, so a date or a #list
                                    tag read out of the sentence would be fighting it.
                                -->
                                <Border Grid.Row="2"
                                        Padding="8"
                                        BorderThickness="0,1,0,0"
                                        BorderBrush="{ThemeResource AstridBorder}">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            The preview. It is the core's answer to "what would a
                                            card born here look like", asked again after every
                                            pick, so the mark shows the card it is about to make
                                            rather than the pick in isolation.
                                        -->
                                        <Button x:Uid="add_card_settings" Grid.Column="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Width="28" Height="28"
                                                VerticalAlignment="Center"
                                                Tag="{x:Bind Id}"
                                                Loaded="OnColumnAddSettingsLoaded"
                                                Click="OnColumnAddSettingsOpened"
                                                AutomationProperties.Name="Card settings">
                                            <Grid Width="28" Height="28">
                                                <local:PriorityMark Priority="{x:Bind QuickAddPriority, Mode=OneWay}"
                                                                    Width="28" Height="28"
                                                                    Visibility="{x:Bind QuickAddIsCheckbox, Mode=OneWay, Converter={StaticResource Visible}}" />
                                                <Border Width="22" Height="22"
                                                        CornerRadius="{ThemeResource AstridRadiusSmall}"
                                                        BorderThickness="2"
                                                        local:PriorityOutline.Priority="{x:Bind QuickAddPriority, Mode=OneWay}"
                                                        Visibility="{x:Bind QuickAddIsSquare, Mode=OneWay, Converter={StaticResource Visible}}">
                                                    <TextBlock Text="{x:Bind QuickAddMark, Mode=OneWay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               local:PriorityOutline.Priority="{x:Bind QuickAddPriority, Mode=OneWay}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Button.Flyout>
                                                <!--
                                                    Named so a pick can dismiss it: a Button inside
                                                    a Flyout does not close it the way a
                                                    MenuFlyoutItem closes a MenuFlyout (task
                                                    a7748274, the same trap the list's field hit).
                                                -->
                                                <Flyout x:Name="ColumnAddSettingsFlyout">
                                                    <StackPanel Spacing="10" MinWidth="220">
                                                        <StackPanel x:Uid="add_card_priority" Orientation="Horizontal" Spacing="6"
                                                                    AutomationProperties.Name="Priority">
                                                            <Button x:Uid="add_card_priority_none" Tag="0" Content="&#x25CB;"
                                                                    Style="{StaticResource PriorityChoice}"
                                                                    AutomationProperties.Name="No priority"
                                                                    Click="OnColumnPriorityPicked" />
                                                            <Button x:Uid="add_card_priority_low" Tag="1" Content="!"
                                                                    Style="{StaticResource PriorityChoice}"
                                                                    AutomationProperties.Name="Low"
                                                                    Click="OnColumnPriorityPicked" />
                                                            <Button x:Uid="add_card_priority_medium" Tag="2" Content="!!"
                                                                    Style="{StaticResource PriorityChoice}"
                                                                    AutomationProperties.Name="Medium"
                                                                    Click="OnColumnPriorityPicked" />
                                                            <Button x:Uid="add_card_priority_high" Tag="3" Content="!!!"
                                                                    Style="{StaticResource PriorityChoice}"
                                                                    AutomationProperties.Name="High"
                                                                    Click="OnColumnPriorityPicked" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{x:Bind QuickAddAssignees, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="bindings:AssigneeOption">
                                                                    <Button HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Left"
                                                                            Tag="{x:Bind UserId}"
                                                                            Click="OnColumnAssigneeChosen">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock Text="{x:Bind Glyph}"
                                                                                       Width="24" TextAlignment="Center" />
                                                                            <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <TextBox x:Uid="add_card_to_column" Grid.Column="1"
                                                 PlaceholderText="Add task"
                                                 AutomationProperties.Name="Add task"
                                                 Text="{x:Bind Draft, Mode=TwoWay}"
                                                 Background="{ThemeResource AstridSurface}"
                                                 FontSize="12"
                                                 KeyDown="OnAddCardKeyDown" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--
            The open card's detail, as a CALLOUT anchored to that card (task eb2684bb).

            It used to be an `InlineDetailSlot` spliced into the column's item list, with the
            column growing wider to hold it: detail arrived as another card-shaped block pushed
            in between cards, so there was no side to choose and no arrow to aim. The Mac, the
            iPad and the Android tablet all open a callout here, and now so does this.

            A Popup rather than a Flyout because the position is the CORE's and not the
            framework's: `astrid_rules::rows::callout::place` decides the side, the box and the
            arrow, and a Flyout would insist on its own `FlyoutPlacementMode` instead. The
            offsets are set in code, from that answer.

            IsLightDismissEnabled is off: the pane holds a description editor and a comment box,
            and a light-dismiss popup closes on the first click into either. Closing is the
            card's own toggle and the pane's ✕, as it was when this was a slot.
        -->
        <Popup x:Name="CardCallout"
               IsLightDismissEnabled="False"
               ShouldConstrainToRootBounds="True">
            <!--
                The frame is inset by ArrowGutter on the CARD's side, and the arrow lives in
                that gutter. It is not decoration: a Popup CLIPS its child to the child's own
                bounds, so an arrow hung off the frame on a negative margin is laid out,
                reported to UI Automation, and never drawn — which is exactly what happened the
                first time.

                Which side is inset is set in code, from the core's answer, and so is the
                frame's width. The box the core places is the panel PLUS that gutter, because
                its near edge sits on the card's edge now (astrid-ios AITD-679) and it is the
                arrow's tip, not the panel, that has to meet the card.
            -->
            <Grid x:Name="CardCalloutRoot">
                <Border x:Name="CardCalloutFrame"
                        CornerRadius="{ThemeResource AstridRadiusLarge}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource AstridBorder}"
                        Background="{ThemeResource AstridSurface}">
                    <ContentControl x:Uid="open_task" x:Name="CardCalloutHost"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="Open task"
                                    Loaded="OnCardCalloutHostLoaded" />
                </Border>

                <!--
                    The arrow: a square turned 45 degrees and pushed half its width off the
                    edge, so two of its sides draw as the point and the other two are covered
                    by the frame. The same shape the list's pane uses.

                    Its Y comes from the core's `arrowOffset`, which is measured from the
                    callout's TOP and points at the ROW's middle — after clamping those are not
                    the same thing, and drawing it at the callout's own midpoint is the mistake
                    the rule exists to stop. Which EDGE it sits on is the core's `side`. Both
                    are set in code, because both are answers rather than constants.
                -->
                <Border x:Name="CardCalloutArrow"
                        Width="16" Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AstridSurface}"
                        BorderThickness="1,0,0,1"
                        BorderBrush="{ThemeResource AstridBorder}"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="45" CenterX="8" CenterY="8" />
                            <TranslateTransform x:Name="CardCalloutArrowOffset" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
