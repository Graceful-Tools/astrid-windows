<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Astrid.App.Views.ListHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bindings="using:Astrid.Core.Bindings"
    xmlns:local="using:Astrid.App"
    xmlns:views="using:Astrid.App.Views"
    xmlns:settings="using:Astrid.App.Views.Settings"
    xmlns:viewmodels="using:Astrid.App.ViewModels">

    <!--
        The row above the list: its name, the tools, and what the connection is doing.

        The list's settings are a flyout of their own (ListSettingsFlyout). The account and the
        bell were both here once and are the sidebar's now (tasks ffcc6abf and 96759883), which is
        where astrid-web keeps them — see SidebarView.xaml.
    -->

    <Grid Margin="20,16,20,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!--
            The title yields, the tools do not.

            This was a horizontal StackPanel, and a StackPanel never shrinks its
            children: with the detail pane open the row wanted more width than it had
            and the toolbar was clipped off the right — the filter, the chat, the view
            toggles, all of them gone with nothing to say they had been there. A Grid
            lets the list name truncate, which is the thing on that row that can afford
            to.
        -->
        <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
                The list's picture beside its name, as the web draws it over the list
                (task 3a913e52). Only when the list has one: the web draws a hashed default
                icon otherwise, which this shell does not (CONTRACTS.md D14).
            -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Shell.HasListImage, Mode=OneWay, Converter={StaticResource Visible}}">
                <Image x:Uid="list_image" Stretch="UniformToFill"
                       AutomationProperties.Name="List image"
                       Source="{x:Bind Shell.ListImageSource, Mode=OneWay, Converter={StaticResource RemoteImage}}" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind Shell.Tasks.ListName, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
            <!--
                Search replaces what the list shows rather than opening a screen of its
                own: the results are rows like any other, and they complete and open the
                same way. A second surface that behaved almost-but-not-quite like the
                list is how two code paths for one thing begin.
            -->
            <!--
                What the list is filtered and sorted by. The values come from the core,
                which is the only place they are matched on — a filter set here means
                the same thing on web and on the Mac, because it is the same string.
            -->
            <Button x:Uid="filter_button_2" x:Name="FilterButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Filters"
                    ToolTipService.ToolTip="{x:Bind Shell.Tasks.IsFiltered, Mode=OneWay, Converter={StaticResource FilterText}}"
                    Content="&#xE71C;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Foreground="{x:Bind Shell.Tasks.IsFiltered, Mode=OneWay, Converter={StaticResource FilterTint}}">
                <Button.Flyout>
                    <Flyout Opening="OnFiltersOpening">
                        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind Shell.Tasks.FilterGroups, Mode=OneWay}"
                                          MinWidth="240">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="bindings:FilterGroup">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{x:Bind TitleKey, Converter={StaticResource PickTitle}}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ItemsControl ItemsSource="{x:Bind Picks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="bindings:FilterPick">
                                                        <RadioButton Content="{x:Bind TitleKey, Converter={StaticResource PickTitle}}"
                                                                     IsChecked="{x:Bind IsSelected}"
                                                                     GroupName="{x:Bind Field}"
                                                                     Checked="OnFilterChosen" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!--
                The conversation about this list. A panel beside the tasks rather than
                a screen of its own: it is about the work on the left, and reading it
                should not mean losing sight of that.
            -->
            <ToggleButton x:Uid="chat_toggle" x:Name="ChatToggle"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Chat"
                          ToolTipService.ToolTip="Chat"
                          Content="&#xE8BD;"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          IsChecked="{x:Bind Shell.IsChatOpen, Mode=OneWay}"
                          Click="OnToggleChat" />
            <!--
                The list's own settings: its name, who it is shared with, and the way
                out of it. Behind a button rather than always on screen, because it is
                the thing somebody does once per list and never again.
            -->
            <Button x:Uid="list_settings_button" x:Name="ListSettingsButton"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="List settings"
                    ToolTipService.ToolTip="List settings"
                    Content="&#xE713;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}">
                <Button.Flyout>
                    <Flyout Opening="OnListSettingsOpening">
                        <views:ListSettingsFlyout x:Name="ListSettings" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!--
                The board and the list are two views of one list's work, not two
                screens: the toggle swaps what is drawn and nothing else moves.
                Drawn only on a list that HAS a board (task a66f0a16), as
                astrid-web's header is — the account's project_mode flag alone was
                offering it on every list, with a notice as the only outcome.
            -->
            <ToggleButton x:Uid="board_toggle" x:Name="BoardToggle"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Board view"
                          ToolTipService.ToolTip="Board view"
                          Content="&#xF0E2;"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          IsChecked="{x:Bind Shell.IsBoardView, Mode=OneWay}"
                          Visibility="{x:Bind Shell.ShowsBoardToggle, Mode=OneWay, Converter={StaticResource Visible}}"
                          Click="OnToggleBoard" />
                <!--
                    Search collapses to its icon, which is what astrid-web does when the
                    row is short: a box wide enough to type in does not fit beside a
                    list name, four tools and an open task, and a box squeezed to a
                    sliver is worse than a button that opens one.
                -->
                <Button x:Uid="search_tasks" AutomationProperties.Name="Search tasks"
                        ToolTipService.ToolTip="Search tasks"
                        Content="&#xE721;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}">
                    <Button.Flyout>
                        <Flyout>
                            <AutoSuggestBox x:Uid="search_box" x:Name="SearchBox"
                                            Width="280"
                                            QueryIcon="Find"
                                            PlaceholderText="Search tasks"
                                            AutomationProperties.Name="Search tasks"
                                            TextChanged="OnSearchChanged" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <!--
            What the app can currently see, in one row: quiet, because none of it is a problem
            the person has to do anything about.

            One row and not three cells, because they used to be separate claims on the same
            column and drew on top of each other — the same bug the toolbar comment above
            records. The states can coexist: unsent work and a dead stream are both true after
            an edit made on a train.

            Offline and live-updates-off are two different facts sharing a slot, and only ever
            one of them shows at a time: ShowsLiveUpdatesDown is false while ShowsOffline is
            true, decided in the view model and not here (task ef92df55). Offline means no sync
            pass has reached the server and nothing at all is getting through. Live updates off
            means only the stream dropped — writes still work, and the app simply will not hear
            about somebody else's edit until the next pass. So that one comes with a way to try
            again, which is exactly what a machine waking from sleep needs: the core's backoff
            was chosen for a network that has since come back.
        -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
            <TextBlock x:Uid="not_synced_yet"
                       Text="Not synced yet"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind Shell.HasUnsentWork, Mode=OneWay, Converter={StaticResource Visible}}" />
            <TextBlock x:Uid="status_offline"
                       Text="Offline"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind Shell.ShowsOffline, Mode=OneWay, Converter={StaticResource Visible}}" />
            <TextBlock x:Uid="status_live_updates_off"
                       Text="Live updates are off"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind Shell.ShowsLiveUpdatesDown, Mode=OneWay, Converter={StaticResource Visible}}" />
            <HyperlinkButton x:Uid="reconnect_stream"
                             Content="Reconnect"
                             ToolTipService.ToolTip="Try the live stream again now"
                             VerticalAlignment="Center"
                             Click="OnReconnectStream"
                             Visibility="{x:Bind Shell.ShowsLiveUpdatesDown, Mode=OneWay, Converter={StaticResource Visible}}" />
            <!--
                A write the server refused, and the way out of it (task 84e077ca). Not a kind of
                "not synced yet": that one is about waiting, and waiting ends on its own. This one
                does not, which is why it is the only thing in this row with something to press.

                The count is the core's `retryable`, not its `failed` (task 22e9bc7b): a refused
                delete is never replayed, so `failed` includes writes this link cannot reach, and
                drawn here that was "1 refused" over a link answering "nothing to retry" with no
                way for either to ever go away. The number beside a button is a number the button
                can act on.

                The count's sentence comes from a converter, not from the view model — the number
                is the fact, the words are the translator's. It is read again straight after the
                retry, so a write refused a second time leaves this saying so rather than the
                outcome line claiming it was sent.
            -->
            <TextBlock Text="{x:Bind Shell.RetryableRefusedWrites, Mode=OneWay, Converter={StaticResource RefusedWrites}}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind Shell.RetryableRefusedWrites, Mode=OneWay, Converter={StaticResource Visible}}" />
            <HyperlinkButton x:Uid="retry_refused_writes"
                             Content="Try again"
                             ToolTipService.ToolTip="Send the refused writes again"
                             VerticalAlignment="Center"
                             Click="OnRetryRefusedWrites"
                             Visibility="{x:Bind Shell.RetryableRefusedWrites, Mode=OneWay, Converter={StaticResource Visible}}" />
            <TextBlock Text="{x:Bind Shell.LastRetryRevived, Mode=OneWay, Converter={StaticResource RetryOutcome}}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind Shell.ShowsRetryOutcome, Mode=OneWay, Converter={StaticResource Visible}}" />
        </StackPanel>
        <!--
            There were two more columns here, holding Account, Sync and Sign out in one row and
            then latterly only the bell. The account button went to the foot of the sidebar
            (task 3f5834ed, then ffcc6abf) and the bell to the sidebar's header row
            (task 96759883), both because that is where astrid-web keeps them. Empty Auto columns
            are not free — ColumnSpacing pays for every gap between them, drawn in or not — so
            they went with the last control rather than being left behind as dead width.
        -->
    </Grid>
</UserControl>
