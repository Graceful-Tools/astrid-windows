<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The managed side of the C ABI in crates/astrid-ffi.

    Deliberately NOT a WinUI project and deliberately not Windows-targeted beyond what P/Invoke
    needs: the tests reference it, and a test project that has to start the Windows App SDK to
    check a JSON round-trip is a test project nobody runs.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- P/Invoke into a hand-written C ABI: the analyser's marshalling advice does not apply. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RustTargetRoot>$(MSBuildThisFileDirectory)..\..\target\</RustTargetRoot>
  </PropertyGroup>

  <!--
    Carry the core's DLL next to whatever consumes this.

    Cargo puts it under target/<profile>/ for a host build and target/<triple>/<profile>/ for a
    cross build, and the .NET configuration does not have to match the cargo profile — a Release
    test run against a debug core is a perfectly ordinary thing to want. So this looks in a short
    ordered list and takes the first that exists, preferring the matching profile.

    If none exists the build still succeeds, with a warning that says which command to run. A
    missing DLL surfaces at startup as "Unable to load DLL 'astrid_ffi'", which sends people
    looking at their PATH rather than at their build order.

    A STALE one is quieter and worse. `dotnet build` does not run cargo, and `cargo test -p
    astrid-core` does not build this crate, so a core change plus a shell build leaves the app
    talking to the previous core — where a new command comes back as an unknown one and the screen
    that needed it is simply empty. After changing the core, run `cargo build -p astrid-ffi` before
    running the app. `npm run predeploy` builds the Rust first and never sees this.

    A MISMATCHED one is the worst of the three, and it shipped. The candidates used to vary only by
    cargo profile, never by architecture, so an x86 or x64 build of the app was handed whichever
    core the host happened to have built — on an ARM64 machine, an ARM64 one. The app then died at
    startup with `BadImageFormatException` before it drew anything. That is how a sign-in callback
    came to launch a build that could not start: the browser opened the app, the app crashed, and
    the only evidence was a stack trace in a log nobody was looking at.

    So the architecture decides the candidate list, and a build with no matching core is an ERROR
    rather than a warning. A build that cannot produce a runnable app should not produce one.
  -->
  <Target Name="ResolveAstridCoreLibrary" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_RustProfile Condition="'$(Configuration)' == 'Release'">release</_RustProfile>
      <_RustProfile Condition="'$(_RustProfile)' == ''">debug</_RustProfile>
      <_OtherRustProfile Condition="'$(_RustProfile)' == 'release'">debug</_OtherRustProfile>
      <_OtherRustProfile Condition="'$(_RustProfile)' == 'debug'">release</_OtherRustProfile>

      <!--
        What this build will actually run as. The RID wins when there is one, because that is what
        `dotnet build -r win-arm64` means; otherwise the platform the app project was built for;
        otherwise the SDK's own, which is the right answer for the test projects since they run as
        the host.
      -->
      <_AstridArch Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</_AstridArch>
      <_AstridArch Condition="'$(_AstridArch)' == '' and $(RuntimeIdentifier.EndsWith('-x64'))">x64</_AstridArch>
      <_AstridArch Condition="'$(_AstridArch)' == '' and $(RuntimeIdentifier.EndsWith('-x86'))">x86</_AstridArch>
      <_AstridArch Condition="'$(_AstridArch)' == '' and '$(PlatformTarget)' != '' and '$(PlatformTarget)' != 'AnyCPU'">$(PlatformTarget.ToLowerInvariant())</_AstridArch>
      <_AstridArch Condition="'$(_AstridArch)' == '' and '$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform.ToLowerInvariant())</_AstridArch>
      <_AstridArch Condition="'$(_AstridArch)' == ''">$(NETCoreSdkRuntimeIdentifier.Replace('win-', ''))</_AstridArch>

      <_AstridTriple Condition="'$(_AstridArch)' == 'arm64'">aarch64-pc-windows-msvc</_AstridTriple>
      <_AstridTriple Condition="'$(_AstridArch)' == 'x64'">x86_64-pc-windows-msvc</_AstridTriple>
      <_AstridTriple Condition="'$(_AstridArch)' == 'x86'">i686-pc-windows-msvc</_AstridTriple>

      <!--
        `target/<profile>/` is cargo's HOST output, so it is only the right core when this build
        runs as the host. Taking it otherwise is exactly the mismatch described above.
      -->
      <_AstridHostArch>$(NETCoreSdkRuntimeIdentifier.Replace('win-', ''))</_AstridHostArch>
      <_AstridHostIsTarget Condition="'$(_AstridArch)' == '$(_AstridHostArch)'">true</_AstridHostIsTarget>
    </PropertyGroup>

    <ItemGroup>
      <!-- The matching triple first, in either profile: a Release shell against a debug core is an
           ordinary thing to want, and the gate does exactly that. -->
      <_AstridCoreCandidate Condition="'$(_AstridTriple)' != ''"
                            Include="$(RustTargetRoot)$(_AstridTriple)\$(_RustProfile)\astrid_ffi.dll" />
      <_AstridCoreCandidate Condition="'$(_AstridTriple)' != ''"
                            Include="$(RustTargetRoot)$(_AstridTriple)\$(_OtherRustProfile)\astrid_ffi.dll" />
      <_AstridCoreCandidate Condition="'$(_AstridHostIsTarget)' == 'true'"
                            Include="$(RustTargetRoot)$(_RustProfile)\astrid_ffi.dll" />
      <_AstridCoreCandidate Condition="'$(_AstridHostIsTarget)' == 'true'"
                            Include="$(RustTargetRoot)$(_OtherRustProfile)\astrid_ffi.dll" />
    </ItemGroup>

    <ItemGroup>
      <_AstridCoreFound Include="@(_AstridCoreCandidate)" Condition="Exists('%(FullPath)')" />
    </ItemGroup>

    <PropertyGroup>
      <!-- The first that exists. Taking one rather than all of them, because two candidates would
           both copy to the same `Link` and race. -->
      <_AstridCoreLibrary>%(_AstridCoreFound.FullPath)</_AstridCoreLibrary>
    </PropertyGroup>

    <ItemGroup Condition="'$(_AstridCoreLibrary)' != ''">
      <None Include="$(_AstridCoreLibrary)">
        <Link>astrid_ffi.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <Error Condition="'$(_AstridCoreLibrary)' == '' and '$(_AstridTriple)' != ''"
           Code="ASTRID001"
           Text="No astrid_ffi.dll for $(_AstridArch). Run: cargo build -p astrid-ffi --target $(_AstridTriple)  (or, when building for the host, plain `cargo build -p astrid-ffi`). Copying a core of another architecture would build an app that cannot start." />

    <Error Condition="'$(_AstridTriple)' == ''"
           Code="ASTRID002"
           Text="Unknown target architecture '$(_AstridArch)'. astrid_ffi.dll is native, so this build has no way to know which one to carry." />
  </Target>

</Project>
