# Normalise to LF in the repository; Git checks out the platform's native endings.
* text=auto

*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.mjs     text eol=lf
*.yml     text eol=lf

# PowerShell and the .NET project files are read by Windows tooling; keep them CRLF.
*.ps1     text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf

# The vendored design copies are hashed, not just read: `DesignTokenTests` checks the
# `body-sha256` astrid-core stamped on the art. Git would otherwise check it out CRLF here (there
# is no `*.xaml` rule, and `text=auto` picks the platform), and the stamp is over LF.
design/AstridCheckbox.xaml text eol=lf

*.png     binary
*.ico     binary
*.pfx     binary
